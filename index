       TAB 3: MASTER TASK SHEET
       ========================================== */
    window.addTaskRow = function(customField) {
      const d = getDefaultDateForNewItem();
      state.tasks.unshift({
        id: 'tk_' + Date.now() + '_' + Math.floor(Math.random() * 1000),
        field: customField || 'Work',
        aspect: 'Daily',
        activity: '',
        priority: 'High',
        note: '',
        drop: false,
        timeless: false,
        status: 'Assigned',
        start: d,
        startHour: '08:00',
        end: d,
        endHour: '17:30',
        done: false,
        inputPct: 0
      });
      saveState();
    };

    window.quickAddFieldTask = function(field) {
      window.addTaskRow(field);
      window.switchTab('tasks', document.querySelectorAll('.nav-item')[2]);
    };

    window.updateTask = function(id, key, val) {
      const t = state.tasks.find(function(x) { return x.id === id; });
      if (!t) return;
      if (key === 'inputPct') {
        const pct = Math.min(100, Math.max(0, Number(val) || 0));
        t.inputPct = pct;
        if (pct === 100) { t.done = true; t.status = 'Completed'; t.drop = false; }
        else { t.done = false; if (pct > 0 && normStatus(t.status) === 'Assigned') t.status = 'In progress'; }
      } else if (key === 'done') {
        t.done = Boolean(val);
        if (t.done) { t.inputPct = 100; t.status = 'Completed'; t.drop = false; }
        else { t.inputPct = 50; t.status = 'In progress'; }
      } else if (key === 'drop') {
        t.drop = Boolean(val); t.status = t.drop ? 'Dropped' : 'Assigned'; if (t.drop) t.done = false;
      } else if (key === 'status') {
        t.status = val;
        if (val === 'Completed') { t.done = true; t.inputPct = 100; t.drop = false; }
        else if (val === 'Dropped') { t.drop = true; t.done = false; }
        else { t.drop = false; t.done = false; }
      } else {
        t[key] = val;
      }
      saveState();
    };

    window.deleteTask = function(id) {
      state.tasks = state.tasks.filter(function(x) { return x.id !== id; });
      saveState();
    };

    window.renderTasks = function() {
      try {
        const realToday = getRealTodayISO();
        const needToday = state.tasks.filter(function(t) { return isTaskActiveOnDate(t, realToday) && !t.done && Number(t.inputPct) < 100; }).length;
        const nonDropped = state.tasks.filter(function(t) { return !t.drop; });
        const doneList = nonDropped.filter(function(t) { return t.done || Number(t.inputPct) >= 100; });
        const overdueList = nonDropped.filter(function(t) { return isTaskOverdue(t); });
        const openList = nonDropped.filter(function(t) { return !t.done && Number(t.inputPct) < 100; });
        const dropList = state.tasks.filter(function(t) { return t.drop; });

        setText('tk-kpi-today', needToday);
        setText('tk-kpi-total', nonDropped.length);
        setText('tk-kpi-open', openList.length);
        setText('tk-kpi-done', doneList.length);
        setText('tk-kpi-overdue', overdueList.length);
        setText('tk-kpi-drop', dropList.length);

        const fField = getVal('flt-field', 'ALL');
        const fAspect = getVal('flt-aspect', 'ALL');
        const fStatus = getVal('flt-status', 'ALL');
        const fSearch = getVal('flt-search', '').trim().toLowerCase();

        const filtered = state.tasks.filter(function(t) {
          if (fField !== 'ALL' && normField(t.field) !== fField) return false;
          if (fAspect !== 'ALL' && normAspect(t.aspect) !== fAspect) return false;
          if (fStatus !== 'ALL' && normStatus(t.status) !== fStatus) return false;
          if (fSearch && !((t.activity || '').toLowerCase().indexOf(fSearch) >= 0 || (t.note || '').toLowerCase().indexOf(fSearch) >= 0)) return false;
          return true;
        });

        const tbody = byId('task-sheet-tbody');
        if (!tbody) return;
        if (filtered.length === 0) {
          tbody.innerHTML = '<tr><td colspan="16" style="text-align:center;padding:24px;color:var(--text-muted);font-weight:600;">Chưa có công việc nào. Nhấn <strong>+ Thêm dòng công việc</strong> để tạo mới.</td></tr>';
          return;
        }

        tbody.innerHTML = filtered.map(function(t) {
          const nf = normField(t.field);
          const na = normAspect(t.aspect);
          const np = normPrio(t.priority);
          const ns = normStatus(t.status);
          const totalDaysTxt = t.timeless ? 'Lặp lại' : (calcTotalDays(t.start, t.end) + ' ngày');
          let badgeHtml = '';
          if (t.drop) badgeHtml = '<span class="badge-rect badge-muted">Đã hủy</span>';
          else if (t.done || Number(t.inputPct) >= 100) badgeHtml = '<span class="badge-rect badge-mint">Hoàn thành</span>';
          else if (t.timeless) badgeHtml = '<span class="badge-rect badge-blue">Đang diễn ra</span>';
          else {
            const dl = calcDaysLeft(t.end);
            if (dl < 0) badgeHtml = '<span class="badge-rect badge-red">Quá hạn ' + Math.abs(dl) + ' ngày</span>';
            else if (dl === 0) badgeHtml = '<span class="badge-rect badge-pink">Đến hạn hôm nay</span>';
            else if (dl <= 3) badgeHtml = '<span class="badge-rect badge-pink">Còn ' + dl + ' ngày</span>';
            else badgeHtml = '<span class="badge-rect badge-yellow">Còn ' + dl + ' ngày</span>';
          }
          const startHours = HOURS_LIST.map(function(h) { return '<option value="' + h + '" ' + (t.startHour === h ? 'selected' : '') + '>' + vi(h) + '</option>'; }).join('');
          const endHours = HOURS_LIST.map(function(h) { return '<option value="' + h + '" ' + (t.endHour === h ? 'selected' : '') + '>' + vi(h) + '</option>'; }).join('');
          const barColor = (t.done || t.inputPct >= 100) ? 'var(--c-mint)' : (isTaskOverdue(t) ? 'var(--c-pink)' : 'var(--c-blue)');
          const pctNum = Number(t.inputPct) || 0;

          return '<tr class="' + (t.drop ? 'row-dropped' : (t.done ? 'row-done' : '')) + '">' +
            '<td><select class="rect-select ' + getFieldCss(nf) + '" onchange="updateTask(\'' + t.id + '\',\'field\',this.value)">' + TASK_FIELDS.map(function(f) { return '<option value="' + f + '" ' + (nf === f ? 'selected' : '') + '>' + vi(f) + '</option>'; }).join('') + '</select></td>' +
            '<td><select class="rect-select" style="background:#F8FAFC;" onchange="updateTask(\'' + t.id + '\',\'aspect\',this.value)">' + ['Daily','Weekly','Monthly','Yearly'].map(function(a) { return '<option value="' + a + '" ' + (na === a ? 'selected' : '') + '>' + vi(a) + '</option>'; }).join('') + '</select></td>' +
            '<td><textarea class="sheet-textarea" style="font-weight:700;" placeholder="Nhập mô tả công việc..." onchange="updateTask(\'' + t.id + '\',\'activity\',this.value)">' + esc(t.activity) + '</textarea></td>' +
            '<td><select class="rect-select ' + getPrioCss(np) + '" onchange="updateTask(\'' + t.id + '\',\'priority\',this.value)">' + ['Urgent','High','Medium','Low'].map(function(p) { return '<option value="' + p + '" ' + (np === p ? 'selected' : '') + '>' + vi(p) + '</option>'; }).join('') + '</select></td>' +
            '<td><textarea class="sheet-textarea" placeholder="Ghi chú, liên kết tài liệu..." onchange="updateTask(\'' + t.id + '\',\'note\',this.value)">' + esc(t.note) + '</textarea></td>' +
            '<td style="text-align:center;"><input type="checkbox" style="width:17px;height:17px;accent-color:var(--c-pink);" ' + (t.drop ? 'checked' : '') + ' onchange="updateTask(\'' + t.id + '\',\'drop\',this.checked)" /></td>' +
            '<td><div style="display:flex;align-items:center;gap:6px;"><div style="flex:1;height:8px;background:#E2E8F0;border-radius:999px;overflow:hidden;"><div style="width:' + pctNum + '%;height:100%;background:' + barColor + ';"></div></div><span class="title-font" style="font-size:0.73rem;font-weight:800;min-width:34px;text-align:right;">' + pctNum + '%</span></div></td>' +
            '<td style="text-align:center;"><input type="checkbox" style="width:17px;height:17px;accent-color:var(--c-blue);" ' + (t.timeless ? 'checked' : '') + ' onchange="updateTask(\'' + t.id + '\',\'timeless\',this.checked)" /></td>' +
            '<td style="text-align:center;font-weight:700;">' + totalDaysTxt + '</td>' +
            '<td style="text-align:center;">' + badgeHtml + '</td>' +
            '<td><select class="rect-select ' + getStatusCss(ns) + '" onchange="updateTask(\'' + t.id + '\',\'status\',this.value)">' + ['Assigned','In progress','Completed','Overdue','Dropped'].map(function(s) { return '<option value="' + s + '" ' + (ns === s ? 'selected' : '') + '>' + vi(s) + '</option>'; }).join('') + '</select></td>' +
            '<td><div class="datetime-merged"><input type="date" min="2020-01-01" max="2050-12-31" class="dt-date" value="' + (t.start || '') + '" onchange="updateTask(\'' + t.id + '\',\'start\',this.value)" /><select class="dt-hour" onchange="updateTask(\'' + t.id + '\',\'startHour\',this.value)">' + startHours + '</select></div></td>' +
            '<td><div class="datetime-merged"><input type="date" min="2020-01-01" max="2050-12-31" class="dt-date" value="' + (t.end || '') + '" onchange="updateTask(\'' + t.id + '\',\'end\',this.value)" /><select class="dt-hour" onchange="updateTask(\'' + t.id + '\',\'endHour\',this.value)">' + endHours + '</select></div></td>' +
            '<td style="text-align:center;"><input type="checkbox" style="width:17px;height:17px;accent-color:var(--c-blue);" ' + (t.done ? 'checked' : '') + ' onchange="updateTask(\'' + t.id + '\',\'done\',this.checked)" /></td>' +
            '<td><input type="text" inputmode="numeric" class="money-input" value="' + pctNum + '" onchange="updateTask(\'' + t.id + '\',\'inputPct\',this.value)" /></td>' +
            '<td style="text-align:center;"><button class="btn-trash" onclick="deleteTask(\'' + t.id + '\')">' + TRASH_ICON + '</button></td>' +
          '</tr>';
        }).join('');
      } catch (e) { console.error(e); }
    };

    /* ==========================================
       TAB 4: PERSONAL CALENDAR (MONDAY -> SUNDAY, UP TO 2050)
       ========================================== */
    function dateObjToISO(d) {
      return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
    }

    function renderCalendar() {
      try {
        const realToday = getRealTodayISO();
        const ym = calYM();
        setText('cal-month-heading', formatMonthYearLabel(calMonth, calYear));

        const firstDateOfMonth = new Date(calYear, calMonth - 1, 1, 12, 0, 0);
        const firstDay = firstDateOfMonth.getDay();
        const offset = (firstDay + 6) % 7;
        const daysInMonth = new Date(calYear, calMonth, 0, 12, 0, 0).getDate();
        const totalSlots = Math.ceil((offset + daysInMonth) / 7) * 7;

        const monthTasks = state.tasks.filter(function(t) { return !t.drop && ((t.start || '').indexOf(ym) === 0 || (t.end || '').indexOf(ym) === 0); });
        const monthDone = monthTasks.filter(function(t) { return t.done || Number(t.inputPct) >= 100; }).length;

        let busyDaysCount = 0;
        const grid = byId('cal-grid-cells');
        if (grid) {
          grid.innerHTML = '';

          for (let slot = 0; slot < totalSlots; slot++) {
            const dayOffset = slot - offset + 1;
            const cellDateObj = new Date(calYear, calMonth - 1, dayOffset, 12, 0, 0);
            const dateStr = dateObjToISO(cellDateObj);
            const isCurrentMonth = (cellDateObj.getFullYear() === calYear && (cellDateObj.getMonth() + 1) === calMonth);

            const cell = document.createElement('div');
            let stateClass = isCurrentMonth ? 'day-future' : 'day-outside';
            if (dateStr === realToday) stateClass = 'day-today';
            else if (isCurrentMonth && dateStr < realToday) stateClass = 'day-past';

            cell.className = 'cal-cell ' + stateClass + ' ' + (dateStr === selectedCalDate ? 'selected' : '');

            const tasksToday = state.tasks.filter(function(t) {
              return !t.drop && !t.timeless && (t.start === dateStr || t.end === dateStr || (t.start <= dateStr && t.end >= dateStr && calcTotalDays(t.start, t.end) <= 7));
            });
            const needCount = tasksToday.filter(function(t) { return !t.done && Number(t.inputPct) < 100; }).length;
            if (isCurrentMonth && tasksToday.length > 0) busyDaysCount++;

            let statusBadge = '';
            if (needCount > 0) statusBadge = '<div class="cal-count-tag" style="background:var(--c-pink);color:#FFFFFF;">Cần làm: ' + needCount + '</div>';
            else if (tasksToday.length > 0) statusBadge = '<div class="cal-count-tag" style="background:var(--c-mint);color:var(--text-dark);">Xong ' + tasksToday.length + '</div>';

            const chips = tasksToday.slice(0, 2).map(function(t) {
              return '<div class="cal-chip ' + (t.done ? 'done' : '') + '">' + esc(t.activity || 'Chưa đặt tên') + '</div>';
            }).join('');

            const dayNumLabel = isCurrentMonth
              ? String(cellDateObj.getDate())
              : (String(cellDateObj.getDate()).padStart(2, '0') + ' ' + getMonthShortName(cellDateObj.getMonth() + 1));

            cell.innerHTML = '<div style="display:flex;justify-content:space-between;align-items:center;"><span class="cal-num" style="' + (!isCurrentMonth ? 'color:var(--text-muted);font-size:0.74rem;' : '') + '">' + dayNumLabel + '</span>' + (dateStr === realToday ? '<span class="cal-today-tag">Hôm nay</span>' : '') + '</div>' + statusBadge + chips;
            cell.onclick = function() {
              selectedCalDate = dateStr;
              if (!isCurrentMonth) {
                calYear = cellDateObj.getFullYear();
                calMonth = cellDateObj.getMonth() + 1;
                activeYear = calYear;
                activeMonth = calMonth;
                syncMonthInputs();
              }
              renderAll();
            };
            grid.appendChild(cell);
          }
        }

        const selTasks = state.tasks.filter(function(t) { return isTaskActiveOnDate(t, selectedCalDate); });
        const selNeed = selTasks.filter(function(t) { return !t.done && Number(t.inputPct) < 100; }).length;

        setText('cal-kpi-sel-need', selNeed);
        setText('cal-kpi-month-total', monthTasks.length);
        setText('cal-kpi-month-done', monthDone);
        setText('cal-kpi-busy-days', busyDaysCount + ' ngày');
        setText('cal-selected-badge', formatISOToDateDisplay(selectedCalDate));
        setText('cal-selected-summary', selNeed + ' chưa xong / ' + selTasks.length + ' tổng số việc');

        const listHtml = selTasks.length === 0
          ? '<div style="padding:14px;text-align:center;color:var(--text-muted);background:var(--bg-soft);border-radius:var(--radius-sm);">Không có công việc nào vào ngày ' + formatISOToDateDisplay(selectedCalDate) + '.</div>'
          : selTasks.map(function(t) {
              return '<div style="padding:9px 11px;border-radius:var(--radius-sm);border:1px solid var(--border-color);background:var(--bg-soft);display:flex;justify-content:space-between;align-items:center;"><div><strong>' + esc(t.activity || 'Chưa đặt tên') + '</strong><div style="font-size:0.75rem;color:var(--text-muted);">' + vi(normField(t.field)) + ' • ' + (Number(t.inputPct) || 0) + '%</div></div><button class="btn-trash" onclick="deleteTask(\'' + t.id + '\')">' + TRASH_ICON + '</button></div>';
            }).join('');
        setHTML('cal-selected-list', listHtml);
      } catch (e) { console.error(e); }
    }

