  <script>
    window.addEventListener('error', function(e) { console.error(e.message); });

    const STORAGE_KEY = 'kduytr_life_os_v8';
    let memoryStore = null;


    const VI_MAP = {"Work": "Công việc", "Study": "Học tập", "Project": "Dự án", "Lifestyle": "Sinh hoạt", "Other": "Khác", "Daily": "Hằng ngày", "Weekly": "Hằng tuần", "Monthly": "Hằng tháng", "Yearly": "Hằng năm", "Urgent": "Khẩn cấp", "High": "Cao", "Medium": "Trung bình", "Low": "Thấp", "Assigned": "Đã giao", "In progress": "Đang làm", "Completed": "Hoàn thành", "Overdue": "Quá hạn", "Dropped": "Đã hủy", "Wishlist": "Mong muốn", "Applied": "Đã nộp", "OA / test": "Bài test", "Interview": "Phỏng vấn", "Offer": "Offer", "Rejected": "Bị loại", "On-site": "Tại chỗ", "Hybrid": "Kết hợp", "Remote": "Từ xa", "Idea / wishlist": "Ý tưởng", "Planning": "Đang lên kế hoạch", "Booked": "Đã đặt", "Cancelled": "Đã hủy", "Flight": "Máy bay", "Train": "Tàu hỏa", "Car / motorbike": "Ô tô / xe máy", "Bus / coach": "Xe buýt / xe khách", "Cruise": "Du thuyền", "Food & dining": "Ăn uống", "Shopping": "Mua sắm", "Transport": "Di chuyển", "Entertainment": "Giải trí", "Education": "Giáo dục", "Bills & utilities": "Hóa đơn", "Salary & bonus": "Lương và thưởng", "Side income": "Thu nhập phụ", "Installments & credit": "Trả góp và thẻ", "Loans": "Vay mượn", "Regular savings": "Tiết kiệm định kỳ", "Emergency fund": "Quỹ dự phòng", "Income contribution": "Đóng góp thu nhập", "Direct savings": "Tiết kiệm trực tiếp", "Bank transfer": "Chuyển khoản", "Cash": "Tiền mặt", "Credit / debit card": "Thẻ ngân hàng", "E-wallet": "Ví điện tử", "Whole family": "Cả gia đình", "Myself": "Bản thân", "Parents": "Bố mẹ", "Siblings": "Anh chị em", "Vision board": "Bảng tầm nhìn", "Annual goal": "Mục tiêu năm", "Monthly goal": "Mục tiêu tháng"};
    function vi(k) { return Object.prototype.hasOwnProperty.call(VI_MAP, k) ? VI_MAP[k] : k; }

    function renderAll() {
      updateLiveClockBar();
      [renderOverview, renderVision, renderTasks, renderCalendar, renderWorkAndStudy, renderJobs, renderTravel, renderHabits, renderFinance, renderFamily, renderAnalytics, updateSettingsCounts].forEach(function(fn) {
        try { fn(); } catch (e) { console.error(e); }
      });
    }

    function byId(id) { return document.getElementById(id); }
    function setText(id, val) { const el = byId(id); if (el) el.textContent = String(val); }
    function setHTML(id, html) { const el = byId(id); if (el) el.innerHTML = html; }
    function getVal(id, fallback) { const el = byId(id); return el ? el.value : (fallback || ''); }

    function readStorage() {
      try {
        const s = window['localStorage'];
        if (s) return s.getItem(STORAGE_KEY);
      } catch (e) { console.error(e); }
      return memoryStore;
    }

    function writeStorage(val) {
      memoryStore = val;
      try {
        const s = window['localStorage'];
        if (s) s.setItem(STORAGE_KEY, val);
      } catch (e) { console.error(e); }
    }

    /* Standard English abbreviated month names (Jan - Dec) */
    const MONTH_NAMES = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

    function getMonthShortName(m) {
      const idx = Math.min(12, Math.max(1, Number(m) || 1)) - 1;
      return MONTH_NAMES[idx];
    }

    function formatMonthYearLabel(m, y) {
      return getMonthShortName(m) + ' ' + y;
    }

    const TASK_FIELDS = ['Work', 'Study', 'Project', 'Lifestyle', 'Other'];
    const EXPENSE_CATS = ['Food & dining', 'Shopping', 'Transport', 'Entertainment', 'Education', 'Bills & utilities', 'Other'];
    const FINANCE_ALL_CATS = ['Salary & bonus', 'Side income', 'Installments & credit', 'Loans', 'Regular savings', 'Emergency fund'].concat(EXPENSE_CATS);
    const FAMILY_EXPENSE_CATS = ['Food & dining', 'Shopping', 'Transport', 'Entertainment', 'Education', 'Bills & utilities', 'Other'];
    const JOB_STAGES = ['Wishlist', 'Applied', 'OA / test', 'Interview', 'Offer', 'Rejected'];
    const JOB_MODES = ['On-site', 'Hybrid', 'Remote'];
    const TRAVEL_STATUSES = ['Idea / wishlist', 'Planning', 'Booked', 'Completed', 'Cancelled'];
    const HOURS_LIST = ['06:00','07:00','07:30','08:00','08:30','09:00','09:30','10:00','10:30','11:00','11:30','12:00','13:30','14:00','15:00','16:00','17:00','17:30','18:00','19:00','20:00','21:00','22:00','23:00'];
    const TRASH_ICON = '<svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>';

    /* Legacy Vietnamese & Title Case normalization to clean Sentence case */
    function normField(f) {
      const map = { 'Công việc': 'Work', 'Học tập': 'Study', 'Dự án': 'Project', 'Sinh hoạt': 'Lifestyle', 'Khác': 'Other' };
      return map[f] || (TASK_FIELDS.indexOf(f) >= 0 ? f : 'Work');
    }
    function normAspect(a) {
      const map = { 'Trong ngày': 'Daily', 'Trong tuần': 'Weekly', 'Trong tháng': 'Monthly', 'Trong năm': 'Yearly' };
      return map[a] || (['Daily','Weekly','Monthly','Yearly'].indexOf(a) >= 0 ? a : 'Daily');
    }
    function normPrio(p) {
      const map = { 'Khẩn cấp': 'Urgent', 'Cao': 'High', 'Trung bình': 'Medium', 'Thấp': 'Low' };
      return map[p] || (['Urgent','High','Medium','Low'].indexOf(p) >= 0 ? p : 'High');
    }
    function normStatus(s) {
      const map = {
        'Đang giao': 'Assigned',
        'Đang làm': 'In progress',
        'In Progress': 'In progress',
        'Hoàn thành': 'Completed',
        'Quá hạn': 'Overdue',
        'Đã hủy': 'Dropped'
      };
      return map[s] || (['Assigned','In progress','Completed','Overdue','Dropped'].indexOf(s) >= 0 ? s : 'Assigned');
    }
    function normExpCat(c) {
      const map = {
        'Ăn uống': 'Food & dining', 'Food & Dining': 'Food & dining',
        'Mua sắm': 'Shopping',
        'Di chuyển': 'Transport',
        'Giải trí': 'Entertainment',
        'Học tập': 'Education',
        'Hóa đơn': 'Bills & utilities', 'Bills & Utilities': 'Bills & utilities',
        'Khác': 'Other',
        'Lương & thưởng': 'Salary & bonus', 'Salary & Bonus': 'Salary & bonus',
        'Thu nhập phụ': 'Side income', 'Side Income': 'Side income',
        'Trả góp & thẻ': 'Installments & credit', 'Installments & Credit': 'Installments & credit',
        'Vay mượn': 'Loans',
        'Tiết kiệm định kỳ': 'Regular savings', 'Regular Savings': 'Regular savings',
        'Quỹ dự phòng': 'Emergency fund', 'Emergency Fund': 'Emergency fund',
        'Tiền vào': 'Income contribution', 'Income Contribution': 'Income contribution',
        'Tiết kiệm': 'Direct savings', 'Direct Savings': 'Direct savings'
      };
      return map[c] || c || 'Food & dining';
    }
    function normJobStage(st) {
      if (st === 'OA / Test') return 'OA / test';
      return JOB_STAGES.indexOf(st) >= 0 ? st : 'Applied';
    }
    function normTravelStatus(st) {
      if (st === 'Idea / Wishlist') return 'Idea / wishlist';
      return TRAVEL_STATUSES.indexOf(st) >= 0 ? st : 'Planning';
    }

    function getRealTodayISO() {
      const now = new Date();
      return now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0') + '-' + String(now.getDate()).padStart(2, '0');
    }

    function formatISOToDateDisplay(iso) {
      if (!iso) return '';
      const p = String(iso).split('-');
      if (p.length !== 3) return iso;
      return p[2] + ' ' + getMonthShortName(Number(p[1])) + ' ' + p[0];
    }

    function shortMonthDayDate(iso) {
      if (!iso) return '';
      const p = String(iso).split('-');
      return p.length === 3 ? (p[2] + ' ' + getMonthShortName(Number(p[1]))) : iso;
    }

    function formatDots(val) {
      const num = Math.round(Number(val) || 0);
      const sign = num < 0 ? '-' : '';
      const absStr = Math.abs(num).toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');
      return sign + absStr;
    }

    function parseDots(str) {
      return Math.round(Number(String(str || '0').replace(/\./g, '').replace(/[^\d]/g, '')) || 0);
    }

    window.formatMoneyLive = function(el) {
      if (!el) return;
      const raw = el.value.replace(/\./g, '').replace(/[^\d]/g, '');
      el.value = raw ? formatDots(raw) : '0';
    };

    function formatVND(val) { return formatDots(val) + ' VND'; }
    function esc(str) { return String(str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }

    function createEmptyState() {
      return {
        profile: { code: 'KD', brand: 'Hệ thống quản lý cuộc đời', name: 'Khánh Duy', role: 'Life management', quote: 'Không khó, chỉ là mới' },
        tasks: [],
        habits: [],
        finance: [],
        family: [],
        visions: [],
        jobs: [],
        travel: [],
        workNotes: '',
        studyNotes: '',
        familyAutoSaveSurplus: true
      };
    }

    function sanitizeLoadedState(rawObj) {
      const base = createEmptyState();
      if (!rawObj || typeof rawObj !== 'object') return base;
      base.profile = Object.assign(base.profile, rawObj.profile || {});
      if (!base.profile.brand || base.profile.brand === 'Khánh Duy life' || base.profile.brand.toUpperCase() === 'QUẢN TRỊ CUỘC ĐỜI') {
        base.profile.brand = 'Hệ thống quản lý cuộc đời';
      }
      if (base.profile.quote === 'It is not hard, ' + 'it is just new') base.profile.quote = 'Không khó, chỉ là mới';
      base.tasks = (Array.isArray(rawObj.tasks) ? rawObj.tasks : []).map(function(t) {
        return Object.assign({}, t, {
          field: normField(t.field),
          aspect: normAspect(t.aspect),
          priority: normPrio(t.priority),
          status: normStatus(t.status)
        });
      });
      base.habits = (Array.isArray(rawObj.habits) ? rawObj.habits : []).map(function(h) {
        return Object.assign({}, h, { field: normField(h.field) });
      });
      base.finance = (Array.isArray(rawObj.finance) ? rawObj.finance : []).map(function(f) {
        const mMap = { 'Chuyển khoản': 'Bank transfer', 'Bank Transfer': 'Bank transfer', 'Tiền mặt': 'Cash', 'Thẻ ngân hàng': 'Credit / debit card', 'Credit / Debit Card': 'Credit / debit card', 'Ví điện tử': 'E-wallet', 'E-Wallet': 'E-wallet' };
        return Object.assign({}, f, {
          category: normExpCat(f.category),
          method: mMap[f.method] || f.method || 'Bank transfer'
        });
      });
      base.family = (Array.isArray(rawObj.family) ? rawObj.family : []).map(function(f) {
        const memMap = { 'Gia đình chung': 'Whole family', 'Whole Family': 'Whole family', 'Bản thân': 'Myself', 'Bố mẹ': 'Parents', 'Anh chị em': 'Siblings' };
        return Object.assign({}, f, {
          category: normExpCat(f.category),
          member: memMap[f.member] || f.member || 'Whole family'
        });
      });
      base.visions = (Array.isArray(rawObj.visions) ? rawObj.visions : []).map(function(v) {
        const sMap = {
          'Bảng tầm nhìn': 'Vision board', 'Vision Board': 'Vision board',
          'Mục tiêu năm': 'Annual goal', 'Annual Goal': 'Annual goal',
          'Mục tiêu tháng': 'Monthly goal', 'Monthly Goal': 'Monthly goal'
        };
        return Object.assign({}, v, { scope: sMap[v.scope] || v.scope || 'Vision board', field: normField(v.field) });
      });
      base.jobs = (Array.isArray(rawObj.jobs) ? rawObj.jobs : []).map(function(j) {
        return Object.assign({}, j, { stage: normJobStage(j.stage), priority: normPrio(j.priority) });
      });
      base.travel = (Array.isArray(rawObj.travel) ? rawObj.travel : []).map(function(tr) {
        const trpMap = { 'Car / Motorbike': 'Car / motorbike', 'Bus / Coach': 'Bus / coach' };
        return Object.assign({}, tr, {
          status: normTravelStatus(tr.status),
          transport: trpMap[tr.transport] || tr.transport || 'Flight'
        });
      });
      base.workNotes = typeof rawObj.workNotes === 'string' ? rawObj.workNotes : '';
      base.studyNotes = typeof rawObj.studyNotes === 'string' ? rawObj.studyNotes : '';
      base.familyAutoSaveSurplus = rawObj.familyAutoSaveSurplus !== false;
      return base;
    }

    let state = (function() {
      try {
        const raw = readStorage();
        if (raw) return sanitizeLoadedState(JSON.parse(raw));
      } catch (e) { console.error(e); }
      return createEmptyState();
    })();

    let currentTab = 'overview';
    const realNow = new Date();
    let activeYear = realNow.getFullYear();
    let activeMonth = realNow.getMonth() + 1;
    let calYear = realNow.getFullYear();
    let calMonth = realNow.getMonth() + 1;
    let selectedCalDate = getRealTodayISO();
    let currentImportMode = 'merge';
    let activeFamilyWeekKey = '';

    function saveState() {
      writeStorage(JSON.stringify(state));
      renderAll();
    }

    function activeYM() { return activeYear + '-' + String(activeMonth).padStart(2, '0'); }
    function calYM() { return calYear + '-' + String(calMonth).padStart(2, '0'); }

    /* Dynamic 12-month series using Jan - Dec labels synced to active year */
    function get12MonthsSeries() {
      const arr = [];
      const y = activeYear;
      for (let m = 1; m <= 12; m++) {
        const ym = y + '-' + String(m).padStart(2, '0');
        const shortName = getMonthShortName(m);
        arr.push({
          ym: ym,
          shortLbl: shortName,
          lbl: shortName + ' ' + y,
          y: y,
          m: m
        });
      }
      return arr;
    }

    function updateLiveClockBar() {
      const now = new Date();
      const tStr = String(now.getHours()).padStart(2, '0') + ':' + String(now.getMinutes()).padStart(2, '0') + ':' + String(now.getSeconds()).padStart(2, '0');
      setText('live-clock-bar', 'Hôm nay: ' + formatISOToDateDisplay(getRealTodayISO()) + ', ' + tStr + '  |  Kỳ đang xem: ' + formatMonthYearLabel(activeMonth, activeYear));
    }

    const TAB_HEADERS = {
      overview:  { title: '1. System overview', btn: '+ Thêm công việc' },
      vision:    { title: '2. Vision board & goals', btn: '+ Thêm mục tiêu' },
      tasks:     { title: '3. Task sheet', btn: '+ Thêm dòng công việc' },
      calendar:  { title: '4. Personal calendar', btn: '+ Thêm công việc' },
      work:      { title: '5. Work & projects', btn: '+ Thêm công việc' },
      study:     { title: '6. Study & research', btn: '+ Thêm chủ đề học tập' },
