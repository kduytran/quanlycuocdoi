        }).join(''));

        const sheetHtml = filteredTx.length === 0
          ? '<tr><td colspan="9" style="text-align:center;padding:24px;color:var(--text-muted);">No family transactions in this view.</td></tr>'
          : filteredTx.map(function(f) {
              const normType = normalizeFamilyType(f.type);
              const nc = normExpCat(f.category);
              const wInfo = getYearWeekInfoFromDate(f.date || getRealTodayISO());
              let typeCss = 'field-Work';
              if (normType === 'Income') typeCss = 'field-Study';
              else if (normType === 'Savings') typeCss = 'field-Lifestyle';

              let catCellHtml = '';
              if (normType === 'Income') {
                catCellHtml = '<select class="rect-select field-Study" onchange="updateFamily(\'' + f.id + '\',\'category\',this.value)"><option value="Income contribution" selected>Đóng góp thu nhập</option></select>';
              } else if (normType === 'Savings') {
                catCellHtml = '<select class="rect-select field-Project" onchange="updateFamily(\'' + f.id + '\',\'category\',this.value)"><option value="Direct savings" selected>Tiết kiệm trực tiếp</option></select>';
              } else {
                const curCat = FAMILY_EXPENSE_CATS.indexOf(nc) >= 0 ? nc : 'Food & dining';
                catCellHtml = '<select class="rect-select" style="background:#F8FAFC;" onchange="updateFamily(\'' + f.id + '\',\'category\',this.value)">' +
                  FAMILY_EXPENSE_CATS.map(function(c) { return '<option value="' + c + '" ' + (curCat === c ? 'selected' : '') + '>' + vi(c) + '</option>'; }).join('') +
                '</select>';
              }

              return '<tr>' +
                '<td><select class="rect-select ' + typeCss + '" onchange="updateFamily(\'' + f.id + '\',\'type\',this.value)">' +
                  '<option value="Income" ' + (normType === 'Income' ? 'selected' : '') + '>Thu nhập tuần</option>' +
                  '<option value="Expense" ' + (normType === 'Expense' ? 'selected' : '') + '>Chi tiêu gia đình</option>' +
                  '<option value="Savings" ' + (normType === 'Savings' ? 'selected' : '') + '>Tiết kiệm trực tiếp</option>' +
                '</select></td>' +
                '<td style="text-align:center;"><div class="week-pill-tag" onclick="selectFamilyWeekKey(\'' + wInfo.key + '\')" style="cursor:pointer;" title="Xem ' + wInfo.label + '">' + wInfo.label + ' (' + wInfo.shortRange + ')</div></td>' +
                '<td>' + catCellHtml + '</td>' +
                '<td><textarea class="sheet-textarea" placeholder="Mô tả khoản mục..." onchange="updateFamily(\'' + f.id + '\',\'title\',this.value)">' + esc(f.title) + '</textarea></td>' +
                '<td><select class="rect-select" style="background:#F8FAFC;" onchange="updateFamily(\'' + f.id + '\',\'member\',this.value)">' +
                  ['Whole family','Myself','Parents','Siblings'].map(function(m) { return '<option value="' + m + '" ' + (f.member === m ? 'selected' : '') + '>' + vi(m) + '</option>'; }).join('') +
                '</select></td>' +
                '<td><input type="text" inputmode="numeric" class="money-input" value="' + formatDots(f.amount) + '" oninput="formatMoneyLive(this)" onchange="updateFamily(\'' + f.id + '\',\'amount\',this.value)" /></td>' +
                '<td style="text-align:center;"><input type="date" min="2020-01-01" max="2050-12-31" class="ui-input" value="' + (f.date || '') + '" onchange="updateFamily(\'' + f.id + '\',\'date\',this.value)" /></td>' +
                '<td><textarea class="sheet-textarea" placeholder="Ghi chú..." onchange="updateFamily(\'' + f.id + '\',\'note\',this.value)">' + esc(f.note) + '</textarea></td>' +
                '<td style="text-align:center;"><button class="btn-trash" onclick="deleteFamily(\'' + f.id + '\')">' + TRASH_ICON + '</button></td>' +
              '</tr>';
            }).join('');
        setHTML('fm-sheet-tbody', sheetHtml);
      } catch (e) { console.error(e); }
    }

    /* ==========================================
       SHARED MONTH STATISTICS
       ========================================== */
    function inMonth(d, ym) { return (d || '').indexOf(ym) === 0; }
    function isDoneTask(t) { return t.done || Number(t.inputPct) >= 100; }

    function monthStats(ym) {
      const tasks = state.tasks.filter(function(t) { return !t.drop && (inMonth(t.start, ym) || inMonth(t.end, ym)); });
      const done = tasks.filter(isDoneTask).length;
      const overdue = tasks.filter(isTaskOverdue).length;
      const study = tasks.filter(function(t) { return normField(t.field) === 'Study'; });
      let checks = 0;
      state.habits.forEach(function(h) { const a = h.months && h.months[ym]; checks += Array.isArray(a) ? a.length : 0; });
      const s = {
        total: tasks.length, done: done, overdue: overdue, prog: tasks.length - done - overdue,
        studyCount: study.length,
        studyAvg: study.length ? Math.round(study.reduce(function(a, t) { return a + (Number(t.inputPct) || 0); }, 0) / study.length) : 0,
        habitChecks: checks,
        habitRate: state.habits.length ? Math.round(checks / (state.habits.length * 30) * 100) : 0,
        pInc: 0, pSav: 0, pExp: 0, pDebt: 0
      };
      state.finance.forEach(function(f) {
        if (!inMonth(f.date, ym)) return;
        const a = Number(f.amount) || 0;
        if (f.type === 'Income') s.pInc += a;
        else if (f.type === 'Savings') s.pSav += a;
        else if (f.type === 'Debts') s.pDebt += a;
        else if (f.type === 'Expenses') s.pExp += a;
      });
      const fam = getFamilyMonthSummary(ym);
      s.fInc = fam.inc; s.fExp = fam.exp; s.fSav = fam.sav;
      return s;
    }

    function compactNum(n) {
      const a = Math.abs(n), sg = n < 0 ? '-' : '';
      if (a >= 1e9) return sg + (a / 1e9).toFixed(1).replace(/\.0$/, '') + 'B';
      if (a >= 1e6) return sg + (a / 1e6).toFixed(1).replace(/\.0$/, '') + 'M';
      if (a >= 1e3) return sg + Math.round(a / 1e3) + 'K';
      return sg + Math.round(a);
    }

    /* ==========================================
       TAB 1: SYSTEM OVERVIEW
       ========================================== */
    function renderOverview() {
      try {
        const ym = activeYM(), rt = getRealTodayISO(), s = monthStats(ym);
        const todayN = state.tasks.filter(function(t) { return isTaskActiveOnDate(t, rt) && !isDoneTask(t); }).length;
        setText('ov-kpi-today', todayN);
        setText('ov-kpi-total', s.total);
        setText('ov-kpi-done', s.done);
        setText('ov-kpi-habit', s.habitRate + '%');
        setText('ov-kpi-savings', formatVND(s.pSav + s.fSav));
        setText('ov-real-today-sub', 'Hôm nay: ' + formatISOToDateDisplay(rt));
        setText('ov-today-alert-pill', 'Hôm nay: ' + todayN + ' việc');
        setText('ov-12m-sub', 'Jan đến Dec của năm ' + activeYear);

        const upcoming = state.tasks.filter(function(t) { return !t.drop && !t.timeless && !isDoneTask(t) && (t.end || '') >= rt; })
          .sort(function(a, b) { return (a.end || '').localeCompare(b.end || '') || (a.startHour || '').localeCompare(b.startHour || ''); })
          .slice(0, 8);
        setHTML('ov-upcoming-container', upcoming.length === 0
          ? '<div style="padding:16px;text-align:center;color:var(--text-muted);">Chưa có công việc sắp tới.</div>'
          : upcoming.map(function(t) {
              const dl = calcDaysLeft(t.end);
              const when = dl === 0 ? 'Hôm nay' : 'Còn ' + dl + ' ngày';
              return '<div style="display:flex;justify-content:space-between;align-items:center;gap:10px;padding:9px 11px;border:1px solid var(--border-color);border-radius:var(--radius-sm);background:var(--bg-soft);"><div style="min-width:0;"><strong>' + esc(t.activity || 'Chưa đặt tên') + '</strong><div style="font-size:0.75rem;color:var(--text-muted);">' + vi(normField(t.field)) + ' • ' + formatISOToDateDisplay(t.end) + ' ' + esc(t.endHour || '') + '</div></div><span class="badge-rect ' + getPrioCss(t.priority) + '" style="min-width:auto;">' + vi(normPrio(t.priority)) + ' • ' + when + '</span></div>';
            }).join(''));

        const mode = getVal('ov-cap-mode', 'task');
        const series = get12MonthsSeries().map(function(m) {
          const st = monthStats(m.ym);
          const v = mode === 'income' ? st.pInc : (mode === 'expense' ? st.pExp : (mode === 'saving' ? st.pSav + st.fSav : (st.total ? Math.round(st.done / st.total * 100) : 0)));
          return { lbl: m.shortLbl, m: m.m, v: v };
        });
        const mx = Math.max.apply(null, series.map(function(x) { return x.v; }).concat([1]));
        setHTML('ov-capsule-bars', series.map(function(x) {
          const h = Math.round(x.v / mx * 100);
          return '<div class="cap-col"><div class="cap-val">' + (mode === 'task' ? x.v + '%' : compactNum(x.v)) + '</div><div class="cap-track"><div class="cap-fill ' + (x.m === activeMonth ? 'active-month' : '') + '" style="height:' + h + '%;"></div></div><div class="cap-lbl">' + x.lbl + '</div></div>';
        }).join(''));

        const cols = { Work: 'var(--c-pink)', Study: 'var(--c-blue)', Project: '#D5DB3B', Lifestyle: 'var(--c-mint)', Other: '#94A3B8' };
        setHTML('ov-5fields-bars', TASK_FIELDS.map(function(f) {
          const list = state.tasks.filter(function(t) { return !t.drop && normField(t.field) === f && (inMonth(t.start, ym) || inMonth(t.end, ym)); });
          const avg = list.length ? Math.round(list.reduce(function(a, t) { return a + (Number(t.inputPct) || 0); }, 0) / list.length) : 0;
          return '<div><div style="display:flex;justify-content:space-between;font-size:0.8rem;font-weight:700;margin-bottom:4px;"><span>' + vi(f) + ' (' + list.length + ' việc)</span><span class="title-font">' + avg + '%</span></div><div style="height:9px;background:#E2E8F0;border-radius:999px;overflow:hidden;"><div style="width:' + avg + '%;height:100%;background:' + cols[f] + ';border-radius:999px;"></div></div></div>';
        }).join(''));
      } catch (e) { console.error(e); }
    }

    /* ==========================================
       TAB 12: CUMULATIVE ANALYTICS (SVG CHARTS)
       ========================================== */
    function niceMax(v) {
      if (!(v > 0)) return 1;
      const p = Math.pow(10, Math.floor(Math.log10(v))), n = v / p;
      return (n <= 1 ? 1 : (n <= 2 ? 2 : (n <= 5 ? 5 : 10))) * p;
    }

    function drawChart(id, labels, series, money) {
      const svg = byId(id);
      if (!svg) return;
      const x0 = 46, x1 = 548, y0 = 14, y1 = 190, W = x1 - x0, H = y1 - y0;
      const maxOf = function(s) { return niceMax(Math.max.apply(null, s.vals.concat([0]))); };
      const shared = series.filter(function(s) { return !s.own; });
      const rawMax = Math.max.apply(null, shared.reduce(function(a, s) { return a.concat(s.vals); }, []).concat([0]));
      const maxP = money ? niceMax(rawMax) : Math.max(4, Math.ceil(rawMax / 4) * 4);
      const scaleOf = function(s) { return s.own ? maxOf(s) : maxP; };
      const empty = series.every(function(s) { return s.vals.every(function(v) { return !v; }); });
      let o = '';
      for (let i = 0; i <= 4; i++) {
        const y = +(y1 - H * i / 4).toFixed(1);
        o += '<line x1="' + x0 + '" y1="' + y + '" x2="' + x1 + '" y2="' + y + '" stroke="#E2E8F0" stroke-width="1"/>';
        if (shared.length) o += '<text x="' + (x0 - 6) + '" y="' + (y + 3) + '" text-anchor="end" font-size="9" fill="#64748B">' + (money ? compactNum(maxP * i / 4) : Math.round(maxP * i / 4)) + '</text>';
      }
      const gw = W / labels.length;
      labels.forEach(function(l, i) {
        o += '<text x="' + (x0 + gw * i + gw / 2).toFixed(1) + '" y="208" text-anchor="middle" font-size="9.5" font-weight="700" fill="#334155">' + l + '</text>';
      });
      const bars = series.filter(function(s) { return s.type !== 'line'; });
      const bw = Math.min(16, gw * 0.78 / Math.max(1, bars.length));
      bars.forEach(function(s, bi) {
        const mx = scaleOf(s);
        s.vals.forEach(function(v, i) {
          const h = v > 0 ? Math.max(2, v / mx * H) : 0;
          const x = x0 + gw * i + (gw - bw * bars.length) / 2 + bw * bi;
          o += '<rect x="' + x.toFixed(1) + '" y="' + (y1 - h).toFixed(1) + '" width="' + (bw - 1).toFixed(1) + '" height="' + h.toFixed(1) + '" rx="2" fill="' + s.color + '"' + (s.stroke ? ' stroke="#CBD5E1" stroke-width="0.8"' : '') + '/>';
        });
      });
      series.filter(function(s) { return s.type === 'line'; }).forEach(function(s) {
        const mx = scaleOf(s);
        const pts = s.vals.map(function(v, i) { return (x0 + gw * i + gw / 2).toFixed(1) + ',' + (y1 - v / mx * H).toFixed(1); });
        o += '<polyline points="' + pts.join(' ') + '" fill="none" stroke="' + s.color + '" stroke-width="2.2" stroke-linejoin="round"/>';
        pts.forEach(function(p) { const c = p.split(','); o += '<circle cx="' + c[0] + '" cy="' + c[1] + '" r="2.6" fill="#FFFFFF" stroke="' + s.color + '" stroke-width="1.6"/>'; });
      });
      if (empty) o += '<text x="' + (x0 + W / 2) + '" y="' + (y0 + H / 2) + '" text-anchor="middle" font-size="12" font-weight="700" fill="#94A3B8">Chưa có dữ liệu</text>';
      svg.innerHTML = o;
    }

    function renderAnalytics() {
      try {
        const months = get12MonthsSeries();
        const st = months.map(function(m) { return monthStats(m.ym); });
        const cur = st[activeMonth - 1];
        setText('an-kpi-rate', (cur.total ? Math.round(cur.done / cur.total * 100) : 0) + '%');
        setText('an-kpi-overdue', cur.overdue);
        setText('an-kpi-habit', cur.habitRate + '%');
        setText('an-kpi-saving', formatVND(cur.pSav + cur.fSav));
        setText('an-kpi-family', formatVND(cur.fExp));

        const lb = months.map(function(m) { return m.shortLbl; });
        const col = function(fn) { return st.map(fn); };
        let ch = 0, cd = 0, cs = 0;
        const cumHabit = st.map(function(s) { ch += s.habitChecks; return ch; });
        const cumDone = st.map(function(s) { cd += s.done; return cd; });
        const cumSav = st.map(function(s) { cs += s.pSav + s.fSav; return cs; });

        drawChart('svgTasks12', lb, [
          { color: '#00DFA2', vals: col(function(s) { return s.done; }) },
          { color: '#0079FF', vals: col(function(s) { return s.prog; }) },
          { color: '#FF0060', vals: col(function(s) { return s.overdue; }) }]);
        drawChart('svgHabits12', lb, [
          { color: '#F6FA70', stroke: 1, vals: col(function(s) { return s.habitChecks; }) },
          { type: 'line', own: 1, color: '#0079FF', vals: cumHabit }]);
        drawChart('svgStudy12', lb, [
          { color: '#00DFA2', vals: col(function(s) { return s.studyCount; }) },
          { type: 'line', own: 1, color: '#FF0060', vals: col(function(s) { return s.studyAvg; }) }]);
        drawChart('svgFinance12', lb, [
          { color: '#0079FF', vals: col(function(s) { return s.pInc; }) },
          { color: '#00DFA2', vals: col(function(s) { return s.pSav; }) },
          { color: '#FF0060', vals: col(function(s) { return s.pExp; }) },
          { color: '#F6FA70', stroke: 1, vals: col(function(s) { return s.pDebt; }) }], true);
        drawChart('svgFamily12', lb, [
          { color: '#0079FF', vals: col(function(s) { return s.fInc; }) },
          { color: '#FF0060', vals: col(function(s) { return s.fExp; }) },
          { color: '#00DFA2', vals: col(function(s) { return s.fSav; }) }], true);
        drawChart('svgCumulativeAll', lb, [
          { type: 'line', own: 1, color: '#0079FF', vals: cumDone },
          { type: 'line', own: 1, color: '#FF0060', vals: cumHabit },
          { type: 'line', own: 1, color: '#00DFA2', vals: cumSav }]);

        setHTML('an-summary-tbody', months.map(function(m, i) {
          const s = st[i];
          const vals = [s.total, s.done, s.prog, s.overdue, s.studyCount, s.habitChecks, s.pInc, s.pSav, s.pExp, s.pDebt, s.fInc, s.fExp, s.fSav];
          return '<tr' + (m.m === activeMonth ? ' style="background:#FEFDE8;font-weight:700;"' : '') + '><td style="text-align:center;font-weight:700;">' + m.lbl + '</td>' +
            vals.map(function(v) { return '<td style="text-align:center;">' + formatDots(v) + '</td>'; }).join('') + '</tr>';
        }).join(''));
      } catch (e) { console.error(e); }
    }

    /* ==========================================
       SETTINGS, BACKUP, RESTORE, RESET
       ========================================== */
    function updateSettingsCounts() {
      setText('st-count-tasks', state.tasks.length);
      setText('st-count-visions', state.visions.length);
      setText('st-count-jobs', state.jobs.length);
      setText('st-count-travel', state.travel.length);
      setText('st-count-habits', state.habits.length);
      setText('st-count-finance', state.finance.length);
      setText('st-count-family', state.family.length);
    }

    function showToast(msg, ok) {
      const el = byId('settings-toast');
      if (!el) return;
      el.textContent = msg;
      el.className = 'status-toast show ' + (ok ? 'ok' : 'err');
    }

    window.openSettingsModal = function() {
      updateSettingsCounts();
      const t = byId('settings-toast'); if (t) t.className = 'status-toast';
      const m = byId('settings-modal'); if (m) m.classList.add('open');
    };
    window.closeSettingsModal = function() {
      const m = byId('settings-modal'); if (m) m.classList.remove('open');
      window.toggleDangerConfirm(false);
    };
    window.handleBackdropClick = function(e) { if (e.target === byId('settings-modal')) window.closeSettingsModal(); };
    window.toggleDangerConfirm = function(show) {
      const p = byId('danger-confirm-panel'); if (p) p.classList.toggle('show', Boolean(show));
    };

    window.exportBackupJson = function() {
      try {
        const blob = new Blob([JSON.stringify(state, null, 2)], { type: 'application/json' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'khanh-duy-life-backup-' + getRealTodayISO() + '.json';
        document.body.appendChild(a); a.click(); document.body.removeChild(a);
        setTimeout(function() { URL.revokeObjectURL(a.href); }, 1500);
        showToast('Đã tải bản sao lưu về máy.', true);
      } catch (e) { console.error(e); showToast('Không thể tạo file sao lưu.', false); }
    };

    window.selectImportMode = function(mode) {
      currentImportMode = mode === 'replace' ? 'replace' : 'merge';
      const a = byId('mode-lbl-merge'), b = byId('mode-lbl-replace');
      if (a) a.classList.toggle('selected', currentImportMode === 'merge');
      if (b) b.classList.toggle('selected', currentImportMode === 'replace');
      document.querySelectorAll('input[name="importMode"]').forEach(function(r) { r.checked = (r.value === currentImportMode); });
    };

    window.triggerFileUploadClick = function() { const i = byId('backup-file-input'); if (i) i.click(); };
    window.handleDragOver = function(e) { e.preventDefault(); };
    window.handleFileDrop = function(e) {
      e.preventDefault();
      const f = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
      if (f) importBackupFile(f);
    };
    window.handleBackupFileSelected = function(input) {
      const f = input && input.files && input.files[0];
      if (f) importBackupFile(f);
      if (input) input.value = '';
    };

    function importBackupFile(file) {
      const reader = new FileReader();
      reader.onload = function() {
        try {
          const incoming = sanitizeLoadedState(JSON.parse(String(reader.result)));
          const lists = ['tasks', 'visions', 'jobs', 'travel', 'habits', 'finance', 'family'];
          lists.forEach(function(k) {
            incoming[k].forEach(function(x, i) { if (!x.id) x.id = k.slice(0, 2) + '_' + Date.now() + '_' + i; });
          });
          if (currentImportMode === 'replace') {
            state = incoming;
          } else {
            lists.forEach(function(k) {
              const idx = {};
              state[k].forEach(function(x, i) { idx[x.id] = i; });
              incoming[k].forEach(function(x) { if (idx[x.id] !== undefined) state[k][idx[x.id]] = x; else state[k].push(x); });
            });
            ['workNotes', 'studyNotes'].forEach(function(k) {
              if (!state[k]) state[k] = incoming[k];
              else if (incoming[k] && state[k].indexOf(incoming[k]) < 0) state[k] += '\n\n' + incoming[k];
            });
          }
          writeStorage(JSON.stringify(state));
          loadProfileUI();
          renderAll();
          showToast('Đã nhập dữ liệu thành công.', true);
        } catch (e) { console.error(e); showToast('File không hợp lệ. Vui lòng chọn đúng file .json đã sao lưu.', false); }
      };
      reader.onerror = function() { showToast('Không đọc được file.', false); };
      reader.readAsText(file);
    }

    window.executeClearAllData = function() {
      state = createEmptyState();
      activeFamilyWeekKey = '';
      writeStorage(JSON.stringify(state));
      loadProfileUI();
      renderAll();
      window.toggleDangerConfirm(false);
      showToast('Đã xóa toàn bộ dữ liệu.', true);
    };

    /* ==========================================
       INIT
       ========================================== */
    loadProfileUI();
    syncMonthInputs();
    setText('top-tab-title', TAB_HEADERS.overview.title);
    setText('primary-add-label', TAB_HEADERS.overview.btn);
    renderAll();
    setInterval(updateLiveClockBar, 1000);
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') window.closeSettingsModal(); });
  </script>

