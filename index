    /* ==========================================
       TAB 9: 30-DAY HABITS
       ========================================== */
    function getHabitDays(h) {
      const ym = activeYM();
      if (!h.months || typeof h.months !== 'object') h.months = {};
      if (!Array.isArray(h.months[ym])) h.months[ym] = [];
      return h.months[ym];
    }

    window.addHabitItem = function() {
      const nameEl = byId('new-habit-title');
      const hname = nameEl ? nameEl.value.trim() : '';
      if (!hname) { if (nameEl) nameEl.focus(); return; }
      state.habits.push({
        id: 'hb_' + Date.now() + '_' + Math.floor(Math.random() * 1000),
        name: hname,
        field: getVal('new-habit-field', 'Lifestyle'),
        months: {}
      });
      if (nameEl) nameEl.value = '';
      saveState();
    };

    window.toggleHabitDay = function(id, day) {
      const h = state.habits.find(function(x) { return x.id === id; });
      if (!h) return;
      const arr = getHabitDays(h);
      const idx = arr.indexOf(day);
      if (idx >= 0) arr.splice(idx, 1); else arr.push(day);
      saveState();
    };

    window.toggleAll30Habit = function(id) {
      const h = state.habits.find(function(x) { return x.id === id; });
      if (!h) return;
      const ym = activeYM();
      h.months[ym] = getHabitDays(h).length === 30 ? [] : Array.from({ length: 30 }, function(_, i) { return i + 1; });
      saveState();
    };

    window.deleteHabit = function(id) {
      state.habits = state.habits.filter(function(x) { return x.id !== id; });
      saveState();
    };

    function renderHabits() {
      try {
        let totalChecks = 0, full30 = 0;
        state.habits.forEach(function(h) { const len = getHabitDays(h).length; totalChecks += len; if (len === 30) full30++; });
        const rate = state.habits.length > 0 ? Math.round((totalChecks / (state.habits.length * 30)) * 100) : 0;
        setText('hb-kpi-count', state.habits.length);
        setText('hb-kpi-checks', totalChecks);
        setText('hb-kpi-full', full30);
        setText('hb-kpi-rate', rate + '%');
        const periodLbl = formatMonthYearLabel(activeMonth, activeYear);
        const html = state.habits.length === 0
          ? '<div style="grid-column:1/-1;padding:24px;text-align:center;color:var(--text-muted);">Chưa có thói quen nào. Hãy thêm ở phía trên.</div>'
          : state.habits.map(function(h) {
              const days = getHabitDays(h);
              let tiles = '';
              for (let d = 1; d <= 30; d++) {
                const done = days.indexOf(d) >= 0;
