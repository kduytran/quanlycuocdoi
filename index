    /* ==========================================
       TAB 11: FAMILY EXPENSES (MONDAY -> SUNDAY ISO WEEKS ACROSS YEAR UP TO 2050)
       ========================================== */
    function normalizeFamilyType(rawType) {
      if (rawType === 'Income' || rawType === 'Thu nhập' || rawType === 'Đóng góp quỹ chung') return 'Income';
      if (rawType === 'Savings' || rawType === 'Tiết kiệm') return 'Savings';
      return 'Expense';
    }

    function getYearWeekInfoFromDate(isoDate) {
      const fallback = isoDate && /^\d{4}-\d{2}-\d{2}$/.test(String(isoDate)) ? String(isoDate) : getRealTodayISO();
      const parts = fallback.split('-').map(Number);
      const dt = new Date(parts[0], parts[1] - 1, parts[2], 12, 0, 0);

      const dayNr = (dt.getDay() + 6) % 7;
      const monday = new Date(dt.getFullYear(), dt.getMonth(), dt.getDate() - dayNr, 12, 0, 0);
      const sunday = new Date(monday.getFullYear(), monday.getMonth(), monday.getDate() + 6, 12, 0, 0);

      const thursday = new Date(monday.getFullYear(), monday.getMonth(), monday.getDate() + 3, 12, 0, 0);
      const weekYear = thursday.getFullYear();
      const firstThursday = new Date(weekYear, 0, 4, 12, 0, 0);
      const firstMonday = new Date(weekYear, 0, 4 - ((firstThursday.getDay() + 6) % 7), 12, 0, 0);
      const weekNo = Math.round((monday.getTime() - firstMonday.getTime()) / (7 * 86400000)) + 1;

      const wStr = String(Math.max(1, weekNo)).padStart(2, '0');
      const startISO = dateObjToISO(monday);
      const endISO = dateObjToISO(sunday);
      return {
        key: weekYear + '-W' + wStr,
        year: weekYear,
        weekNo: weekNo,
        label: 'Tuần ' + wStr + '/' + weekYear,
        startISO: startISO,
        endISO: endISO,
        rangeDisplay: formatISOToDateDisplay(startISO) + ' - ' + formatISOToDateDisplay(endISO),
        shortRange: shortMonthDayDate(startISO) + ' - ' + shortMonthDayDate(endISO)
      };
    }

    function getAllWeeksOfYear(yearNum) {
      const list = [];
      const seen = {};
      const firstThu = new Date(yearNum, 0, 4, 12, 0, 0);
      let cur = new Date(yearNum, 0, 4 - ((firstThu.getDay() + 6) % 7), 12, 0, 0);
      for (let i = 0; i < 54; i++) {
        const info = getYearWeekInfoFromDate(dateObjToISO(cur));
        if (info.year === yearNum && !seen[info.key]) {
          seen[info.key] = true;
          list.push(info);
        }
        cur = new Date(cur.getFullYear(), cur.getMonth(), cur.getDate() + 7, 12, 0, 0);
        if (info.year > yearNum) break;
      }
      return list;
    }

    function computeFamilyAnalytics() {
      const autoSave = state.familyAutoSaveSurplus !== false;
      const weekMap = {};

      const currentRealWeek = getYearWeekInfoFromDate(getRealTodayISO());
      weekMap[currentRealWeek.key] = {
        info: currentRealWeek,
        inc: 0,
        exp: 0,
        manualSav: 0,
        rawBalance: 0,
        autoSav: 0,
        totalWeekSav: 0,
        cumSavings: 0,
        cumNetBalance: 0,
        txCount: 0
      };

      state.family.forEach(function(item) {
        const d = item.date || getRealTodayISO();
        const wInfo = getYearWeekInfoFromDate(d);
        if (!weekMap[wInfo.key]) {
          weekMap[wInfo.key] = {
            info: wInfo,
            inc: 0,
            exp: 0,
            manualSav: 0,
            rawBalance: 0,
            autoSav: 0,
            totalWeekSav: 0,
            cumSavings: 0,
            cumNetBalance: 0,
            txCount: 0
          };
        }
        const bucket = weekMap[wInfo.key];
        const amt = Number(item.amount) || 0;
        const nt = normalizeFamilyType(item.type);
        if (nt === 'Income') bucket.inc += amt;
        else if (nt === 'Savings') bucket.manualSav += amt;
        else bucket.exp += amt;
        bucket.txCount++;
      });

      const sortedKeys = Object.keys(weekMap).sort();
      let runningIncome = 0;
      let runningExpense = 0;
      let runningSavings = 0;
      let runningNetBalance = 0;

      const weeksChronological = sortedKeys.map(function(k) {
        const b = weekMap[k];
        b.rawBalance = b.inc - b.exp - b.manualSav;
        b.autoSav = (autoSave && b.rawBalance > 0) ? b.rawBalance : 0;
        b.totalWeekSav = b.manualSav + b.autoSav;

        runningIncome += b.inc;
        runningExpense += b.exp;
        runningSavings += b.totalWeekSav;
        runningNetBalance += (b.inc - b.exp);

        b.cumIncome = runningIncome;
        b.cumExpense = runningExpense;
        b.cumSavings = runningSavings;
        b.cumNetBalance = runningNetBalance;
        return b;
      });

      return {
        weekMap: weekMap,
        weeksChronological: weeksChronological,
        allTimeIncome: runningIncome,
        allTimeExpense: runningExpense,
        allTimeSavings: runningSavings,
        allTimeNetBalance: runningNetBalance
      };
    }

    function ensureActiveFamilyWeek(analytics) {
