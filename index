    window.saveProfileInfo = function() {
      const prev = state.profile || createEmptyState().profile;
      state.profile = {
        code: prev.code || 'KD',
        brand: (byId('ui-brand-title') ? byId('ui-brand-title').textContent.trim() : '') || 'HỆ THỐNG QUẢN LÝ CUỘC ĐỜI',
        name: (byId('ui-user-name') ? byId('ui-user-name').textContent.trim() : '') || 'Khánh Duy',
        role: (byId('ui-user-role') ? byId('ui-user-role').textContent.trim() : '') || 'Life management',
        quote: prev.quote || 'Không khó, chỉ là mới'
      };
