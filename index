    window.saveNotesArea = function(key, val) {
      state[key] = val;
      writeStorage(JSON.stringify(state));
    };

    function getDefaultDateForNewItem() {
      const rt = getRealTodayISO();
      return rt.indexOf(activeYM()) === 0 ? rt : (activeYM() + '-01');
    }

    function calcTotalDays(start, end) {
      if (!start || !end) return 1;
      const d = Math.round((new Date(end + 'T12:00:00') - new Date(start + 'T12:00:00')) / 86400000) + 1;
      return d > 0 ? d : 1;
    }

    function calcDaysLeft(end) {
      if (!end) return 0;
      return Math.round((new Date(end + 'T12:00:00') - new Date(getRealTodayISO() + 'T12:00:00')) / 86400000);
    }

    function isTaskOverdue(t) {
      if (!t || t.drop || t.done || Number(t.inputPct) >= 100 || t.timeless) return false;
      return calcDaysLeft(t.end) < 0 || normStatus(t.status) === 'Overdue';
    }

    function isTaskActiveOnDate(t, dateStr) {
      if (!t || t.drop) return false;
      const s = t.start || '';
      const e = t.end || '';
      if (t.timeless) return dateStr.indexOf(s.slice(0, 7)) === 0;
      return s <= dateStr && e >= dateStr;
    }

    function getFieldCss(f) {
      const nf = normField(f);
      return nf === 'Work' ? 'field-Work' : (nf === 'Study' ? 'field-Study' : (nf === 'Project' ? 'field-Project' : (nf === 'Lifestyle' ? 'field-Lifestyle' : 'field-Other')));
    }
    function getPrioCss(p) {
      const np = normPrio(p);
      return np === 'Urgent' ? 'prio-Urgent' : (np === 'High' ? 'prio-High' : (np === 'Medium' ? 'prio-Medium' : 'prio-Low'));
    }
    function getStatusCss(s) {
      const ns = normStatus(s);
      return ns === 'Completed' ? 'st-Completed' : (ns === 'In progress' ? 'st-InProgress' : (ns === 'Overdue' ? 'st-Overdue' : (ns === 'Dropped' ? 'st-Dropped' : 'st-Assigned')));
    }

