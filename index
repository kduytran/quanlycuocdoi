              <button class="btn-rect-soft" style="background:var(--c-blue);border-color:var(--c-blue);color:#FFFFFF;" onclick="exportBackupJson()">Sao lưu trước khi xóa</button>
              <button class="btn-primary" style="background:var(--c-pink);border-color:var(--c-pink);" onclick="executeClearAllData()">Xác nhận xóa vĩnh viễn</button>
