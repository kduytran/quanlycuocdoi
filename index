    function getJobStageCss(st) {
      const nst = normJobStage(st);
      if (nst === 'Offer') return 'st-Completed';
      if (nst === 'Interview') return 'st-InProgress';
      if (nst === 'OA / test') return 'field-Project';
      if (nst === 'Rejected') return 'st-Overdue';
      if (nst === 'Wishlist') return 'st-Dropped';
      return 'field-Study';
    }

    function renderJobs() {
      try {
        const list = Array.isArray(state.jobs) ? state.jobs : [];
        const total = list.length;
        const stageCounts = {};
        JOB_STAGES.forEach(function(s) { stageCounts[s] = 0; });
        const modeCounts = { 'On-site': 0, 'Hybrid': 0, 'Remote': 0 };

        list.forEach(function(j) {
          const st = normJobStage(j.stage);
          stageCounts[st]++;
          const md = JOB_MODES.indexOf(j.mode) >= 0 ? j.mode : 'Hybrid';
          modeCounts[md]++;
        });

        const activeApplied = total - stageCounts['Wishlist'];
        const denom = activeApplied > 0 ? activeApplied : (total > 0 ? total : 1);
        const interviewPlus = stageCounts['OA / test'] + stageCounts['Interview'] + stageCounts['Offer'];
        const offerCount = stageCounts['Offer'];
        const respondedCount = interviewPlus + stageCounts['Rejected'];

        const intRate = total > 0 ? Math.round((interviewPlus / denom) * 100) : 0;
        const offerRate = total > 0 ? Math.round((offerCount / denom) * 100) : 0;
        const respRate = total > 0 ? Math.round((respondedCount / denom) * 100) : 0;

        setText('jb-kpi-total', total);
        setText('jb-kpi-interview', stageCounts['Interview'] + stageCounts['OA / test']);
        setText('jb-kpi-offer', offerCount);
        setText('jb-kpi-int-rate', intRate + '%');
        setText('jb-kpi-offer-rate', offerRate + '%');

        const svgPipe = byId('svgJobPipeline');
        if (svgPipe) {
          const stageCols = ['#64748B', '#0079FF', '#E5C800', '#00DFA2', '#009E73', '#FF0060'];
          const maxStage = Math.max.apply(null, JOB_STAGES.map(function(s) { return stageCounts[s]; }).concat([4]));
          let pOut = '';
          const plotH = 145, padT = 24, padL = 36, stepX = 82;
          for (let r = 0; r <= 3; r++) {
            const gy = +(padT + (plotH / 3) * r).toFixed(1);
            pOut += '<line x1="24" y1="' + gy + '" x2="520" y2="' + gy + '" stroke="#E2E8F0" stroke-width="1" stroke-dasharray="' + (r === 3 ? 'none' : '3,3') + '" />';
          }
          JOB_STAGES.forEach(function(st, idx) {
            const cnt = stageCounts[st] || 0;
            const pct = total > 0 ? Math.round((cnt / total) * 100) : 0;
            const bh = Math.max(4, (cnt / maxStage) * plotH);
            const x = padL + idx * stepX;
            const y = +(padT + plotH - bh).toFixed(1);
            pOut += '<rect x="' + x + '" y="' + padT + '" width="44" height="' + plotH + '" rx="5" fill="#F1F5F9" />';
            pOut += '<rect x="' + x + '" y="' + y + '" width="44" height="' + bh.toFixed(1) + '" rx="5" fill="' + stageCols[idx] + '" />';
            pOut += '<text x="' + (x + 22) + '" y="' + Math.max(15, y - 6) + '" text-anchor="middle" font-family="Montserrat, sans-serif" font-size="10.5" font-weight="800" fill="#0F172A">' + cnt + ' (' + pct + '%)</text>';
            pOut += '<text x="' + (x + 22) + '" y="192" text-anchor="middle" font-family="Montserrat, sans-serif" font-size="10" font-weight="700" fill="#334155">' + vi(st) + '</text>';
          });
          svgPipe.innerHTML = pOut;
        }

        const svgRates = byId('svgJobRates');
        if (svgRates) {
          const metrics = [
            { label: 'Tỷ lệ phản hồi', val: Math.min(100, respRate), col: '#0079FF' },
            { label: 'Tỷ lệ phỏng vấn và test', val: Math.min(100, intRate), col: '#00DFA2' },
            { label: 'Tỷ lệ nhận offer', val: Math.min(100, offerRate), col: '#FF0060' }
          ];
          let rOut = '<text x="20" y="24" font-family="Montserrat, sans-serif" font-size="11" font-weight="800" fill="#0079FF">Tỷ lệ chuyển đổi (%)</text>';
          metrics.forEach(function(m, i) {
            const y = 38 + i * 42;
            const bw = Math.max(6, (m.val / 100) * 280);
            rOut += '<text x="20" y="' + (y + 12) + '" font-family="Montserrat, sans-serif" font-size="10" font-weight="700" fill="#1E293B">' + m.label + '</text>';
            rOut += '<rect x="165" y="' + y + '" width="280" height="16" rx="8" fill="#E2E8F0" />';
            rOut += '<rect x="165" y="' + y + '" width="' + bw.toFixed(1) + '" height="16" rx="8" fill="' + m.col + '" />';
            rOut += '<text x="455" y="' + (y + 12) + '" font-family="Montserrat, sans-serif" font-size="10.5" font-weight="800" fill="#0F172A">' + m.val + '%</text>';
          });

          rOut += '<line x1="20" y1="162" x2="520" y2="162" stroke="#E2E8F0" stroke-width="1" />';
          rOut += '<text x="20" y="184" font-family="Montserrat, sans-serif" font-size="10.5" font-weight="800" fill="#0F172A">Hình thức:</text>';
          const modeCols = { 'On-site': '#FF0060', 'Hybrid': '#0079FF', 'Remote': '#00DFA2' };
          JOB_MODES.forEach(function(md, idx) {
            const mc = modeCounts[md] || 0;
            const mpct = total > 0 ? Math.round((mc / total) * 100) : 0;
            const mx = 115 + idx * 138;
            rOut += '<rect x="' + mx + '" y="170" width="126" height="24" rx="6" fill="#FFFFFF" stroke="' + modeCols[md] + '" stroke-width="1.5" />';
            rOut += '<text x="' + (mx + 63) + '" y="186" text-anchor="middle" font-family="Montserrat, sans-serif" font-size="10" font-weight="800" fill="#0F172A">' + vi(md) + ': ' + mc + ' (' + mpct + '%)</text>';
          });
          svgRates.innerHTML = rOut;
        }

        const fStage = getVal('jb-filter-stage', 'ALL');
        const filteredJobs = list.filter(function(j) {
          return fStage === 'ALL' || normJobStage(j.stage) === fStage;
        });

        const tbody = byId('jb-sheet-tbody');
        if (!tbody) return;
        if (filteredJobs.length === 0) {
          tbody.innerHTML = '<tr><td colspan="10" style="text-align:center;padding:24px;color:var(--text-muted);font-weight:600;">Chưa có hồ sơ ứng tuyển nào. Nhấn <strong>+ Thêm hồ sơ ứng tuyển</strong> để bắt đầu theo dõi.</td></tr>';
          return;
        }

        tbody.innerHTML = filteredJobs.map(function(j) {
          const st = normJobStage(j.stage);
          const md = JOB_MODES.indexOf(j.mode) >= 0 ? j.mode : 'Hybrid';
          const pr = normPrio(j.priority);
          return '<tr>' +
            '<td><textarea class="sheet-textarea" style="font-weight:700;" placeholder="Tên công ty..." onchange="updateJob(\'' + j.id + '\',\'company\',this.value)">' + esc(j.company) + '</textarea></td>' +
            '<td><textarea class="sheet-textarea" style="font-weight:700;color:var(--c-blue);" placeholder="Vị trí..." onchange="updateJob(\'' + j.id + '\',\'role\',this.value)">' + esc(j.role) + '</textarea></td>' +
            '<td><select class="rect-select" style="background:#F8FAFC;" onchange="updateJob(\'' + j.id + '\',\'mode\',this.value)">' + JOB_MODES.map(function(m) { return '<option value="' + m + '" ' + (md === m ? 'selected' : '') + '>' + vi(m) + '</option>'; }).join('') + '</select></td>' +
            '<td><select class="rect-select ' + getJobStageCss(st) + '" onchange="updateJob(\'' + j.id + '\',\'stage\',this.value)">' + JOB_STAGES.map(function(s) { return '<option value="' + s + '" ' + (st === s ? 'selected' : '') + '>' + vi(s) + '</option>'; }).join('') + '</select></td>' +
            '<td><select class="rect-select ' + getPrioCss(pr) + '" onchange="updateJob(\'' + j.id + '\',\'priority\',this.value)">' + ['Urgent','High','Medium','Low'].map(function(p) { return '<option value="' + p + '" ' + (pr === p ? 'selected' : '') + '>' + vi(p) + '</option>'; }).join('') + '</select></td>' +
            '<td style="text-align:center;"><input type="date" min="2020-01-01" max="2050-12-31" class="ui-input" value="' + (j.date || '') + '" onchange="updateJob(\'' + j.id + '\',\'date\',this.value)" /></td>' +
            '<td><input type="text" inputmode="numeric" class="money-input" value="' + formatDots(j.salary) + '" oninput="formatMoneyLive(this)" onchange="updateJob(\'' + j.id + '\',\'salary\',this.value)" /></td>' +
            '<td><textarea class="sheet-textarea" placeholder="Thành phố, liên kết nhà tuyển dụng..." onchange="updateJob(\'' + j.id + '\',\'location\',this.value)">' + esc(j.location) + '</textarea></td>' +
            '<td><textarea class="sheet-textarea" placeholder="Câu hỏi phỏng vấn, liên kết JD, phản hồi..." onchange="updateJob(\'' + j.id + '\',\'note\',this.value)">' + esc(j.note) + '</textarea></td>' +
            '<td style="text-align:center;"><button class="btn-trash" onclick="deleteJob(\'' + j.id + '\')">' + TRASH_ICON + '</button></td>' +
          '</tr>';
        }).join('');
      } catch (e) { console.error(e); }
    }

