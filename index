    function getFamilyMonthSummary(ym) {
      const autoSave = state.familyAutoSaveSurplus !== false;
      let mInc = 0, mExp = 0, mManualSav = 0;
      state.family.filter(function(f) { return (f.date || '').indexOf(ym) === 0; }).forEach(function(f) {
        const a = Number(f.amount) || 0;
        const nt = normalizeFamilyType(f.type);
        if (nt === 'Income') mInc += a;
        else if (nt === 'Savings') mManualSav += a;
        else mExp += a;
      });
      const ana = computeFamilyAnalytics();
      let autoSavInMonth = 0;
      ana.weeksChronological.forEach(function(w) {
        if ((w.info.startISO || '').indexOf(ym) === 0 || (w.info.endISO || '').indexOf(ym) === 0) {
          autoSavInMonth += w.autoSav;
        }
      });
      const totalSav = mManualSav + (autoSave ? autoSavInMonth : 0);
      return {
        inc: mInc,
        exp: mExp,
        sav: totalSav,
        rawMonthBal: mInc - mExp
      };
    }

    function renderFamily() {
