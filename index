    window.switchTab = function(tabId, btnEl) {
      currentTab = tabId;
      document.querySelectorAll('.tab-pane').forEach(function(p) { p.classList.remove('active'); });
      const target = byId('pane-' + tabId);
      if (target) target.classList.add('active');
      if (btnEl) {
        document.querySelectorAll('.nav-item').forEach(function(b) { b.classList.remove('active'); });
        btnEl.classList.add('active');
      }
      const meta = TAB_HEADERS[tabId] || TAB_HEADERS.overview;
      setText('top-tab-title', meta.title);
      setText('primary-add-label', meta.btn);
      renderAll();
    };

    function syncMonthInputs() {
      const txt = byId('month-text-input');
      if (txt) txt.value = formatMonthYearLabel(activeMonth, activeYear);
    }

    window.shiftActiveMonth = function(delta) {
      activeMonth += delta;
      if (activeMonth < 1) { activeMonth = 12; activeYear--; }
      if (activeMonth > 12) { activeMonth = 1; activeYear++; }
      if (activeYear < 2020) activeYear = 2020;
      if (activeYear > 2050) activeYear = 2050;
      calYear = activeYear;
      calMonth = activeMonth;
      syncMonthInputs();
      renderAll();
    };

    window.applyDirectMonthText = function(val) {
      const v = String(val || '').trim();
      const mNumeric = v.match(/^(\d{1,2})[\/\-\s](\d{4})$/);
      if (mNumeric) {
        const mm = Number(mNumeric[1]), yy = Number(mNumeric[2]);
        if (mm >= 1 && mm <= 12 && yy >= 2020 && yy <= 2050) {
          activeMonth = mm; activeYear = yy; calMonth = mm; calYear = yy;
        }
      } else {
        const mText = v.match(/^([A-Za-z]{3,9})[\s\/\-]+(\d{4})$/);
        if (mText) {
          const prefix = mText[1].slice(0, 3).toLowerCase();
          const foundIdx = MONTH_NAMES.findIndex(function(mn) { return mn.toLowerCase() === prefix; });
          const yy = Number(mText[2]);
          if (foundIdx >= 0 && yy >= 2020 && yy <= 2050) {
            activeMonth = foundIdx + 1; activeYear = yy; calMonth = foundIdx + 1; calYear = yy;
          }
        }
      }
      syncMonthInputs();
      renderAll();
    };

    window.shiftCalendarMonth = function(delta) {
      calMonth += delta;
      if (calMonth < 1) { calMonth = 12; calYear--; }
      if (calMonth > 12) { calMonth = 1; calYear++; }
      if (calYear < 2020) calYear = 2020;
      if (calYear > 2050) calYear = 2050;
      activeYear = calYear;
      activeMonth = calMonth;
      syncMonthInputs();
      renderAll();
    };

    window.triggerPrimaryAddAction = function() {
      if (currentTab === 'vision') window.addVisionItem();
      else if (currentTab === 'habits') window.addHabitItem();
      else if (currentTab === 'finance') window.addFinanceRow();
      else if (currentTab === 'family') window.addFamilyRow();
      else if (currentTab === 'jobs') window.addJobRow();
      else if (currentTab === 'travel') window.addTravelRow();
      else if (currentTab === 'work') window.quickAddFieldTask('Work');
      else if (currentTab === 'study') window.quickAddFieldTask('Study');
      else {
        window.addTaskRow();
        if (currentTab === 'overview' || currentTab === 'analytics') {
