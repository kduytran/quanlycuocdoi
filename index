    }
    .mode-option.selected { border-color: var(--c-blue); background: var(--c-yellow-soft); font-weight: 600; }
    .status-toast {
      display: none; padding: 9px 11px; border-radius: var(--radius-sm);
      font-size: 0.8rem; font-weight: 700; text-align: center;
    }
    .status-toast.show { display: block; }
    .status-toast.ok { background: var(--c-mint-soft); color: #007A57; border: 1px solid var(--c-mint); }
    .status-toast.err { background: var(--c-pink-soft); color: var(--c-pink); border: 1px solid var(--c-pink); }
    .danger-confirm-box {
