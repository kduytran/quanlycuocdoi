<!DOCTYPE html>
<html lang="vi"><head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Khánh Duy's life management</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&amp;family=Plus+Jakarta+Sans:wght@400;500;600;700&amp;display=swap" rel="stylesheet">
  <style>
    :root {
      /* Primary palette: Blue (#0079FF) - Mint (#00DFA2) - Lime yellow (#F6FA70) - Rose pink (#FF0060) */
      --c-blue: #0079FF;
      --c-mint: #00DFA2;
      --c-mint-dark: #009E73;
      --c-yellow: #F6FA70;
      --c-yellow-dark: #8A7A00;
      --c-pink: #FF0060;

      /* Clean soft tints (minimal gradients) */
      --c-blue-soft: #EBF5FF;
      --c-mint-soft: #E6FBF4;
      --c-yellow-soft: #FEFDE8;
      --c-pink-soft: #FFEBF2;

      /* Unchanged priority colors */
      --prio-urgent: #DF301C;
      --prio-high: #FF9100;
      --prio-med: #FFDDB0;
      --prio-low: #CFEBFF;

      /* Neutral surfaces & typography */
      --bg-body: #F8FAFC;
      --bg-white: #FFFFFF;
      --bg-soft: #FCFDFD;
      --text-dark: #0F172A;
      --text-main: #1E293B;
      --text-muted: #64748B;
      --border-color: #E2E8F0;

      --radius-xl: 14px;
      --radius-lg: 10px;
      --radius-sm: 8px;
      --shadow-sm: 0 2px 10px rgba(15, 23, 42, 0.04);

      --font-title: 'Montserrat', sans-serif;
      --font-text: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background-color: var(--bg-body);
      color: var(--text-main);
      font-family: var(--font-text);
      line-height: 1.5;
      min-height: 100vh;
      display: flex;
      overflow-x: hidden;
    }
    h1, h2, h3, h4, .title-font, .kpi-num, .btn-primary, .btn-blue, .btn-rect-soft, .th-group, .col-head th, .badge-rect {
      font-family: var(--font-title);
    }

    /* Left sidebar navigation */
    .sidebar {
      width: 272px;
      min-width: 272px;
      background: var(--bg-white);
      border-right: 1.5px solid var(--border-color);
      height: 100vh;
      position: sticky;
      top: 0;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 14px 12px;
      overflow-y: auto;
      z-index: 100;
    }
    .brand-box {
      background: var(--c-blue);
      color: #FFFFFF;
      border: 2px solid var(--c-mint);
      border-radius: 10px;
      padding: 10px 12px;
      margin-bottom: 10px;
      text-align: center;
      box-shadow: 0 4px 12px rgba(0, 121, 255, 0.18);
    }
    .brand-name {
      font-family: var(--font-title);
      font-size: 0.82rem;
      font-weight: 800;
      color: #FFFFFF;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      outline: none;
      cursor: text;
      display: block;
    }
    .profile-card {
      position: relative;
      overflow: hidden;
      border-radius: 14px;
      padding: 11px 14px;
      margin-bottom: 10px;
      background: linear-gradient(135deg, #0066FF 0%, #0079FF 55%, #00B894 100%);
      border: 1.5px solid rgba(255, 255, 255, 0.28);
      box-shadow: 0 8px 18px rgba(0, 121, 255, 0.22);
    }
    .profile-card > *:not(.profile-deco) { position: relative; z-index: 2; }
    .profile-deco {
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      background-image: radial-gradient(rgba(255,255,255,0.15) 1.2px, transparent 1.5px);
      background-size: 11px 11px;
    }
    .profile-deco i { position: absolute; display: block; }
    .sh-sun { right: -22px; top: -22px; width: 64px; height: 64px; border-radius: 50%; background: #F6FA70; opacity: 0.92; }
    .sh-ring { right: 22px; bottom: 8px; width: 18px; height: 18px; border-radius: 50%; border: 3.5px solid #00DFA2; opacity: 0.95; }
    .sh-diamond { right: 52px; bottom: -26px; width: 46px; height: 46px; border-radius: 10px; background: #FF0060; transform: rotate(45deg); opacity: 0.82; }
    .sh-tri { right: 64px; top: 10px; width: 0; height: 0; border-left: 7px solid transparent; border-right: 7px solid transparent; border-bottom: 12px solid #F6FA70; transform: rotate(18deg); }
    .sh-dot { right: 44px; top: 28px; width: 7px; height: 7px; border-radius: 50%; background: #00DFA2; }
    .profile-top {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      text-align: left;
      border-left: 4px solid #F6FA70;
      padding-left: 10px;
    }
    .profile-name {
      font-family: var(--font-title);
      font-weight: 800;
      font-size: 1.02rem;
      color: #FFFFFF;
      letter-spacing: -0.01em;
      line-height: 1.2;
      text-shadow: 0 2px 6px rgba(15, 23, 42, 0.22);
      outline: none;
      cursor: text;
    }
    .profile-badge {
      display: inline-block;
      padding: 2px 10px;
      border-radius: 999px;
      background: #F6FA70;
      color: var(--text-dark);
      box-shadow: 0 2px 6px rgba(15, 23, 42, 0.12);
      font-family: var(--font-title);
      font-size: 0.66rem;
      font-weight: 800;
      margin-top: 4px;
      outline: none;
      cursor: text;
    }
    .nav-label { font-family: var(--font-title); font-size: 0.72rem; font-weight: 800; color: var(--text-muted); padding: 7px 8px 3px; }
    .nav-list { display: flex; flex-direction: column; gap: 2px; }
    .nav-item {
      width: 100%; display: flex; align-items: center; gap: 9px;
      padding: 7px 10px; border-radius: var(--radius-sm); border: 1px solid transparent;
      background: transparent; color: var(--text-main); font-family: var(--font-text);
      font-size: 0.85rem; font-weight: 500; text-align: left; cursor: pointer;
      transition: all 0.15s ease;
    }
    .nav-item svg { width: 16px; height: 16px; stroke: currentColor; stroke-width: 2; fill: none; flex-shrink: 0; }
    .nav-item:hover { background: var(--c-yellow-soft); border-color: var(--c-mint); color: var(--text-dark); }
    .nav-item.active {
      background: var(--c-blue);
      border-color: var(--c-blue);
      color: #FFFFFF;
      font-weight: 700;
    }
    .nav-item.active svg { stroke: var(--c-yellow); }

    .sidebar-bottom { padding-top: 10px; border-top: 1px solid var(--border-color); margin-top: 8px; }
    .btn-settings-gear {
      width: 100%; padding: 8px 11px; border-radius: var(--radius-sm);
      border: 1.5px solid var(--c-blue);
      background: var(--c-blue-soft);
      color: var(--text-dark); font-family: var(--font-title); font-size: 0.75rem; font-weight: 700;
      cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 8px;
    }
    .btn-settings-gear:hover { background: var(--c-yellow); border-color: var(--c-pink); }
    .btn-settings-gear-left { display: flex; align-items: center; gap: 8px; }
    .btn-settings-gear svg { width: 16px; height: 16px; stroke: var(--c-blue); stroke-width: 2.1; fill: none; flex-shrink: 0; }
    .settings-badge {
      background: var(--c-pink); color: #FFFFFF; font-size: 0.62rem; font-weight: 700;
      padding: 2px 6px; border-radius: 999px;
    }

    /* Main workspace */
    .main-area { flex: 1; min-width: 0; padding: 16px 22px 34px; display: flex; flex-direction: column; gap: 16px; }
    .top-banner {
      background: var(--bg-white);
      border: 1.5px solid var(--c-blue);
      border-left: 6px solid var(--c-blue);
      border-radius: var(--radius-xl);
      padding: 13px 20px; display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 12px; box-shadow: var(--shadow-sm);
    }
    .top-banner h2 { font-size: 1.15rem; font-weight: 800; color: var(--c-blue); }
    .banner-controls { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .month-switcher {
      display: inline-flex; align-items: center; gap: 5px; background: #FFFFFF;
      border: 1.5px solid var(--c-blue); border-radius: var(--radius-sm); padding: 3px 6px;
    }
    .month-switcher button {
      background: var(--c-yellow); border: 1px solid #D9DF3E; width: 25px; height: 25px;
      border-radius: 5px; cursor: pointer; font-family: var(--font-title); font-weight: 800;
      color: var(--text-dark); font-size: 0.9rem; line-height: 1;
    }
    .month-switcher button:hover { background: var(--c-pink); border-color: var(--c-pink); color: #FFFFFF; }
    .month-direct-input {
      width: 96px; border: 1px solid var(--border-color); border-radius: 5px;
      padding: 3px 6px; font-family: var(--font-title); font-size: 0.8rem;
      font-weight: 700; text-align: center; background: var(--c-yellow-soft); color: var(--text-dark);
    }
    .month-label-display {
      font-family: var(--font-title); font-size: 0.84rem; font-weight: 700;
      color: var(--text-dark); padding: 0 8px; min-width: 110px; text-align: center;
    }
    .btn-primary {
      background: var(--c-pink); color: #FFFFFF; border: 1px solid var(--c-pink);
      padding: 8px 14px; border-radius: var(--radius-sm); font-size: 0.78rem;
      font-weight: 700; cursor: pointer; white-space: nowrap;
    }
    .btn-primary:hover { opacity: 0.92; }
    .btn-blue {
      background: var(--c-blue); color: #FFFFFF; border: 1px solid var(--c-blue);
      padding: 8px 14px; border-radius: var(--radius-sm); font-size: 0.78rem;
      font-weight: 700; cursor: pointer; white-space: nowrap;
    }
    .btn-blue:hover { opacity: 0.92; }
    .btn-rect-soft {
      background: var(--c-yellow); color: var(--text-dark); border: 1px solid #D5DB3B;
      padding: 6px 11px; border-radius: var(--radius-sm); font-size: 0.73rem;
      font-weight: 700; cursor: pointer; white-space: nowrap;
    }
    .btn-rect-soft:hover { background: var(--c-pink); border-color: var(--c-pink); color: #FFFFFF; }
    .btn-icon-top {
      width: 34px; height: 34px; border-radius: var(--radius-sm);
      border: 1.5px solid var(--c-blue); background: var(--c-blue-soft);
      display: inline-flex; align-items: center; justify-content: center;
      cursor: pointer; color: var(--c-blue);
    }
    .btn-icon-top:hover { background: var(--c-pink); border-color: var(--c-pink); color: #FFFFFF; }
    .btn-icon-top svg { width: 17px; height: 17px; stroke: currentColor; stroke-width: 2; fill: none; }

    /* KPI cards - clean solid accents */
    .kpi-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(175px, 1fr)); gap: 12px; }
    .kpi-card {
      background: #FFFFFF; border: 1.5px solid var(--border-color); border-radius: var(--radius-lg);
      padding: 14px 14px; position: relative; overflow: hidden; box-shadow: var(--shadow-sm);
      display: flex; flex-direction: column; justify-content: center; align-items: center;
      text-align: center; min-height: 92px;
    }
    .kpi-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: var(--c-mint); }
    .kpi-card.blue { border-color: var(--c-blue); background: #FFFFFF; }
    .kpi-card.blue::before { background: var(--c-blue); }
    .kpi-card.mint { border-color: var(--c-mint); background: #FFFFFF; }
    .kpi-card.mint::before { background: var(--c-mint); }
    .kpi-card.pink { border-color: var(--c-pink); background: #FFFFFF; }
    .kpi-card.pink::before { background: var(--c-pink); }
    .kpi-card.yellow { border-color: #D5DB3B; background: #FFFFFF; }
    .kpi-card.yellow::before { background: var(--c-yellow); }
    .kpi-card.red { border-color: var(--prio-urgent); background: #FFFFFF; }
    .kpi-card.red::before { background: var(--prio-urgent); }

    .kpi-num { font-size: 1.38rem; font-weight: 800; color: var(--text-dark); line-height: 1.2; }
    .kpi-num.blue-text { color: var(--c-blue); }
    .kpi-num.mint-text { color: var(--c-mint-dark); }
    .kpi-num.pink-text { color: var(--c-pink); }
    .kpi-num.yellow-text { color: var(--c-yellow-dark); }
    .kpi-num.red-text { color: var(--prio-urgent); }
    .kpi-title { font-size: 0.78rem; font-weight: 600; color: var(--text-muted); margin-top: 4px; }

    .tab-pane { display: none; flex-direction: column; gap: 16px; }
    .tab-pane.active { display: flex; }
    .grid-2col { display: grid; grid-template-columns: 1.1fr 1fr; gap: 16px; }
    .grid-charts-2x3 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
    @media (max-width: 1120px) { .grid-2col, .grid-charts-2x3 { grid-template-columns: 1fr; } }

    .panel { background: #FFFFFF; border: 1.5px solid var(--border-color); border-radius: var(--radius-xl); padding: 16px 18px; box-shadow: var(--shadow-sm); }
    .panel-head { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; margin-bottom: 12px; padding-bottom: 9px; border-bottom: 1px solid var(--border-color); }
    .panel-title { font-size: 0.96rem; font-weight: 800; color: var(--c-blue); }
    .panel-sub { font-size: 0.79rem; color: var(--text-muted); margin-top: 2px; }
    .alert-pill { background: var(--c-pink); color: #FFFFFF; font-family: var(--font-title); font-size: 0.73rem; font-weight: 700; padding: 5px 11px; border-radius: var(--radius-sm); }
    .chart-legend { display: flex; gap: 12px; flex-wrap: wrap; font-size: 0.74rem; font-weight: 700; color: var(--text-main); }
    .legend-dot { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 4px; vertical-align: middle; }

    .capsule-chart {
      display: grid; grid-template-columns: repeat(12, 1fr); gap: 6px; height: 180px;
      align-items: end; padding: 12px 6px 6px; background: var(--bg-soft);
      border-radius: var(--radius-sm); border: 1px solid var(--border-color);
    }
    .cap-col { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; gap: 4px; }
    .cap-val { font-family: var(--font-title); font-size: 0.64rem; font-weight: 700; color: var(--text-muted); }
    .cap-track { width: 100%; max-width: 24px; height: 112px; background: #F1F5F9; border-radius: 999px; display: flex; align-items: flex-end; overflow: hidden; border: 1px solid var(--border-color); }
    .cap-fill { width: 100%; border-radius: 999px; background: var(--c-blue); }
    .cap-fill.active-month { background: var(--c-pink); }
    .cap-lbl { font-family: var(--font-title); font-size: 0.65rem; font-weight: 700; color: var(--text-dark); }

    /* Data sheets & tables */
    .filter-bar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; padding: 9px 11px; background: var(--bg-soft); border: 1px solid var(--border-color); border-radius: var(--radius-sm); }
    .ui-select, .ui-input { padding: 6px 10px; border-radius: var(--radius-sm); border: 1px solid var(--border-color); background: #FFFFFF; color: var(--text-dark); font-family: var(--font-text); font-size: 0.83rem; outline: none; }
    .ui-select:focus, .ui-input:focus { border-color: var(--c-blue); }
    .sheet-scroll { width: 100%; overflow-x: auto; border: 1.5px solid var(--border-color); border-radius: var(--radius-sm); background: #FFFFFF; }
    .data-sheet { width: 100%; border-collapse: collapse; min-width: 1860px; }
    .data-sheet th, .data-sheet td { border: 1px solid #E2E8F0; padding: 7px 9px; vertical-align: middle; }
    .th-group { font-size: 0.76rem; font-weight: 800; text-align: center; padding: 8px; }
    .th-warm { background: var(--c-yellow); color: var(--text-dark); }
    .th-green { background: var(--c-mint); color: var(--text-dark); }
    .col-head th { background: #F8FAFC; color: var(--c-blue); font-size: 0.74rem; font-weight: 700; text-align: center; white-space: nowrap; }
    .data-sheet tbody tr.row-done { background: #F2FDF9; }
    .data-sheet tbody tr.row-dropped { opacity: 0.45; background: #F8FAFC; text-decoration: line-through; }

    .sheet-textarea {
      width: 100%; min-height: 42px; border: 1px solid transparent; border-radius: var(--radius-sm);
      background: transparent; color: var(--text-dark); font-family: var(--font-text);
      font-size: 0.85rem; line-height: 1.4; padding: 4px 6px; resize: vertical;
    }
    .sheet-textarea:focus, .sheet-textarea:hover { border-color: var(--c-blue); background: #FFFFFF; outline: none; }
    .rect-select {
      width: 100%; min-width: 135px; padding: 6px 9px; border-radius: var(--radius-sm);
      border: 1px solid rgba(15, 23, 42, 0.14); font-family: var(--font-text);
      font-size: 0.81rem; font-weight: 700; cursor: pointer; text-align: center; outline: none;
    }

    /* 5 task domains - clean solid colors */
    .field-Work { background: var(--c-pink); color: #FFFFFF; }
    .field-Study { background: var(--c-blue); color: #FFFFFF; }
    .field-Project { background: var(--c-yellow); color: var(--text-dark); }
    .field-Lifestyle { background: var(--c-mint); color: var(--text-dark); }
    .field-Other { background: var(--c-pink-soft); color: var(--c-pink); }

    /* Priority colors (strictly preserved) */
    .prio-Urgent { background: var(--prio-urgent); color: #FFFFFF; }
    .prio-High { background: var(--prio-high); color: #FFFFFF; }
    .prio-Medium { background: var(--prio-med); color: #1E293B; }
    .prio-Low { background: var(--prio-low); color: #1E293B; }

    /* Task statuses */
    .st-Assigned { background: var(--c-yellow); color: var(--text-dark); }
    .st-InProgress { background: var(--c-blue); color: #FFFFFF; }
    .st-Completed { background: var(--c-mint); color: var(--text-dark); }
    .st-Overdue { background: var(--prio-urgent); color: #FFFFFF; }
    .st-Dropped { background: #E2E8F0; color: var(--text-muted); }

    .badge-rect {
      display: inline-flex; align-items: center; justify-content: center;
      padding: 4px 9px; border-radius: var(--radius-sm); font-size: 0.72rem;
      font-weight: 700; white-space: nowrap; min-width: 90px; text-align: center;
    }
    .badge-red { background: var(--prio-urgent); color: #FFFFFF; }
    .badge-pink { background: var(--c-pink); color: #FFFFFF; }
    .badge-blue { background: var(--c-blue); color: #FFFFFF; }
    .badge-mint { background: var(--c-mint); color: var(--text-dark); }
    .badge-yellow { background: var(--c-yellow); color: var(--text-dark); }
    .badge-muted { background: #E2E8F0; color: var(--text-muted); }

    .datetime-merged { display: flex; align-items: center; justify-content: center; gap: 4px; background: #F8FAFC; padding: 4px 6px; border-radius: var(--radius-sm); border: 1px solid var(--border-color); }
    .dt-date { border: none; background: transparent; font-family: var(--font-text); font-size: 0.79rem; font-weight: 600; color: var(--text-dark); outline: none; }
    .dt-hour { border: none; border-left: 1px solid var(--border-color); padding-left: 4px; background: transparent; font-family: var(--font-title); font-size: 0.74rem; font-weight: 700; color: var(--c-blue); outline: none; }
    .money-input { width: 100%; padding: 6px 9px; border-radius: var(--radius-sm); border: 1px solid var(--border-color); background: var(--bg-soft); font-family: var(--font-title); font-size: 0.85rem; font-weight: 700; color: var(--text-dark); text-align: center; outline: none; }
    .btn-trash { width: 28px; height: 28px; border-radius: var(--radius-sm); border: none; background: transparent; color: #94A3B8; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
    .btn-trash:hover { background: var(--c-pink-soft); color: var(--c-pink); }
    .btn-trash svg { width: 15px; height: 15px; stroke: currentColor; stroke-width: 2; fill: none; }

    /* Personal calendar */
    .cal-weekday-row {
      display: grid; grid-template-columns: repeat(7, 1fr);
      background: var(--c-blue);
      border: 1.5px solid var(--c-blue); border-bottom: none;
      border-radius: var(--radius-sm) var(--radius-sm) 0 0; padding: 9px 0;
      text-align: center; font-family: var(--font-title); font-size: 0.74rem; font-weight: 800; color: #FFFFFF;
    }
    .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); border: 1.5px solid var(--border-color); border-radius: 0 0 var(--radius-sm) var(--radius-sm); overflow: hidden; background: #FFFFFF; }
    .cal-cell { min-height: 110px; border: 0.5px solid var(--border-color); padding: 7px; display: flex; flex-direction: column; gap: 4px; cursor: pointer; }
    .cal-cell.day-past { background: #F8FAFC; opacity: 0.72; }
    .cal-cell.day-outside { background: #F1F5F9; opacity: 0.55; border-style: dashed; }
    .cal-cell.day-today {
      background: var(--c-yellow-soft);
      border: 2.5px solid var(--c-pink) !important;
      z-index: 2; opacity: 1;
    }
    .cal-cell.day-future { background: #FFFFFF; }
    .cal-cell.selected { outline: 2.5px solid var(--c-blue); z-index: 3; opacity: 1; }
    .cal-num { font-family: var(--font-title); font-size: 0.82rem; font-weight: 800; }
    .cal-today-tag { background: var(--c-pink); color: #FFFFFF; font-family: var(--font-title); font-size: 0.58rem; font-weight: 800; padding: 2px 5px; border-radius: 4px; }
    .cal-count-tag { font-family: var(--font-title); font-size: 0.64rem; font-weight: 700; padding: 2px 5px; border-radius: 4px; text-align: center; }
    .cal-chip { font-size: 0.71rem; padding: 2px 5px; border-radius: 4px; background: var(--c-pink-soft); border-left: 3px solid var(--c-pink); font-weight: 600; word-break: break-word; }
    .cal-chip.done { background: var(--c-mint-soft); border-left-color: var(--c-mint-dark); }

    /* 30-day habits */
    .habit-grid-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 14px; }
    .habit-card { background: #FFFFFF; border: 1.5px solid var(--border-color); border-radius: var(--radius-lg); padding: 14px; display: flex; flex-direction: column; gap: 10px; box-shadow: var(--shadow-sm); }
    .habit-board-30 { display: grid; grid-template-columns: repeat(6, 1fr); border: 2px solid var(--c-blue); border-radius: var(--radius-sm); overflow: hidden; background: #F8FAFC; }
    .habit-tile { aspect-ratio: 1.32 / 1; border: 0.5px solid rgba(0, 121, 255, 0.18); display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; font-family: var(--font-title); font-size: 0.7rem; font-weight: 700; color: var(--text-muted); }
    .habit-tile.done { background: var(--c-mint); color: var(--text-dark); }
    .habit-card.full-30 .habit-board-30 { border-color: var(--c-pink); }
    .habit-card.full-30 .habit-tile.done { background: var(--c-yellow); color: var(--text-dark); }

    .vision-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(275px, 1fr)); gap: 12px; }
    .vision-card { background: var(--bg-white); border: 1.5px solid var(--c-blue); border-top: 4px solid var(--c-mint); border-radius: var(--radius-lg); padding: 14px; display: flex; flex-direction: column; gap: 8px; }
    .cat-grid-7 { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 10px; }
    .cat-box { background: var(--bg-soft); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 10px; text-align: center; }

    /* Vector SVG charts */
    .vector-chart-wrap {
      width: 100%; background: var(--bg-soft); border: 1px solid var(--border-color);
      border-radius: var(--radius-sm); padding: 8px 6px 4px; overflow: hidden;
    }
    .vector-svg { width: 100%; height: auto; display: block; overflow: visible; }

    /* Family weekly & cumulative controls */
    .fm-control-strip {
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 10px; padding: 12px 15px;
      background: var(--c-blue-soft);
      border: 1.5px solid var(--c-blue); border-radius: var(--radius-lg);
    }
    .fm-auto-toggle {
      display: inline-flex; align-items: center; gap: 8px;
      background: #FFFFFF; padding: 6px 11px; border-radius: var(--radius-sm);
      border: 1.5px solid var(--c-blue); cursor: pointer;
      font-size: 0.8rem; font-weight: 700; color: var(--text-dark);
    }
    .fm-dual-panels { display: grid; grid-template-columns: 1.12fr 1fr; gap: 14px; }
    @media (max-width: 1120px) { .fm-dual-panels { grid-template-columns: 1fr; } }
    .fm-balance-box {
      background: #FFFFFF; border: 1.5px solid var(--border-color);
      border-radius: var(--radius-lg); padding: 15px;
      display: flex; flex-direction: column; gap: 10px; box-shadow: var(--shadow-sm);
    }
    .fm-balance-box.week-focus { border-color: var(--c-pink); border-top: 4px solid var(--c-pink); }
    .fm-balance-box.month-focus { border-color: var(--c-blue); border-top: 4px solid var(--c-blue); }
    .fm-mini-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 9px; }
    .fm-mini-item {
      background: var(--bg-soft); border: 1px solid var(--border-color);
      border-radius: var(--radius-sm); padding: 9px 11px;
    }
    .fm-mini-lbl { font-size: 0.74rem; color: var(--text-muted); font-weight: 600; }
    .fm-mini-val { font-family: var(--font-title); font-size: 1rem; font-weight: 800; margin-top: 2px; color: var(--text-dark); }
    .week-pill-tag {
      display: inline-flex; align-items: center; gap: 4px;
      padding: 4px 8px; border-radius: 6px;
      background: var(--c-yellow); border: 1px solid var(--c-blue);
      font-family: var(--font-title); font-size: 0.72rem; font-weight: 700;
      color: var(--text-dark); white-space: nowrap;
    }

    /* Settings & backup modal */
    .modal-backdrop {
      position: fixed; inset: 0; background: rgba(15, 23, 42, 0.52);
      display: none; align-items: center; justify-content: center;
      padding: 20px; z-index: 9999;
    }
    .modal-backdrop.open { display: flex; }
    .modal-dialog {
      width: 100%; max-width: 640px; background: #FFFFFF;
      border: 2px solid var(--c-blue); border-radius: var(--radius-xl);
      box-shadow: 0 20px 50px rgba(15, 23, 42, 0.24); overflow: hidden;
      display: flex; flex-direction: column; max-height: 90vh;
    }
    .modal-header {
      background: var(--c-blue-soft);
      padding: 14px 18px; border-bottom: 1.5px solid var(--border-color);
      display: flex; align-items: center; justify-content: space-between;
    }
    .modal-header h3 { font-size: 0.98rem; font-weight: 800; color: var(--c-blue); display: flex; align-items: center; gap: 8px; }
    .modal-close-btn {
      width: 30px; height: 30px; border-radius: 8px; border: 1px solid var(--border-color);
      background: #FFFFFF; cursor: pointer; font-weight: 800; font-size: 0.95rem; color: var(--text-main);
    }
    .modal-close-btn:hover { background: var(--c-pink); color: #FFFFFF; border-color: var(--c-pink); }
    .modal-body { padding: 16px 18px; overflow-y: auto; display: flex; flex-direction: column; gap: 14px; }
    .setting-block {
      border: 1.5px solid var(--border-color); border-radius: var(--radius-lg);
      padding: 13px 15px; background: var(--bg-soft); display: flex; flex-direction: column; gap: 9px;
    }
    .setting-block.safe-zone { border-color: var(--c-mint); background: var(--c-mint-soft); }
    .setting-block.upload-zone { border-color: var(--c-blue); background: var(--c-blue-soft); }
    .setting-block.danger-zone { border-color: var(--c-pink); background: var(--c-pink-soft); }
    .setting-block-title { font-family: var(--font-title); font-size: 0.86rem; font-weight: 800; color: var(--text-dark); }
    .setting-block-desc { font-size: 0.78rem; color: var(--text-muted); line-height: 1.45; }
    .stats-mini-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(90px, 1fr)); gap: 7px; }
    .stat-pill-box {
      background: #FFFFFF; border: 1px solid var(--border-color); border-radius: var(--radius-sm);
      padding: 7px; text-align: center;
    }
    .stat-pill-num { font-family: var(--font-title); font-size: 0.92rem; font-weight: 800; color: var(--c-blue); }
    .stat-pill-lbl { font-size: 0.68rem; color: var(--text-muted); }
    .upload-dropArea {
      border: 2px dashed var(--c-blue); border-radius: var(--radius-sm);
      padding: 13px; text-align: center; background: #FFFFFF; cursor: pointer;
    }
    .upload-dropArea:hover { background: var(--c-yellow-soft); border-color: var(--c-pink); }
    .import-mode-row { display: flex; gap: 9px; flex-wrap: wrap; }
    .mode-option {
      flex: 1; min-width: 200px; border: 1.5px solid var(--border-color);
      border-radius: var(--radius-sm); padding: 8px 10px; background: #FFFFFF;
